# ============================================================
# Modele des variables d'environnement (COMMITTE dans le depot)
# ------------------------------------------------------------
# Ce fichier ne contient AUCUN secret. Il sert de reference :
# au demarrage, bin/env-sync.sh ajoute au .env du serveur les
# cles qui lui manquent, sans jamais toucher aux valeurs deja
# presentes. Pour changer une valeur en prod : editer le .env
# du serveur via le gestionnaire de fichiers du panneau.
# ============================================================

APP_ENV=prod
APP_SECRET=CHANGE_ME_32_CARACTERES_ALEATOIRES
APP_DEBUG=0

DATABASE_URL="mysql://user:password@127.0.0.1:3306/base?serverVersion=8.0"

MAILER_DSN=smtp://localhost

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=flock

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# --- Panneau d'hebergement Pterodactyl (page Supervision) ----
# URL de l'API client, terminee de sorte que l'identifiant de
# l'utilisateur connecte puisse etre concatene par l'application.
API_RESOURCE_URL=https://panel.example.com/api/resources?email=
API_RESOURCE_TOKEN=CHANGE_ME_TOKEN_PTERODACTYL

# --- Plateforme partenaire -----------------------------------
AXISHUMAIN_URL=https://axishumain.fr

# --- Politique de securite CSP -------------------------------
# CSP_ENFORCE=0 : observation seulement (Report-Only)
# CSP_ENFORCE=1 : politique appliquee
CSP_ENFORCE=0
CSP_STRICT=0
CSP_REPORT_URI=

# --- Generation de PDF ---------------------------------------
WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf
