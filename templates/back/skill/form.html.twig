{% extends 'base_back.html.twig' %}

{% block title %}{{ mode }}{% endblock %}

{% block content %}
<div class="container py-4" style="max-width: 720px;">
    <a href="{{ url('back_skill_index') }}" class="small text-muted text-decoration-none">Retour aux competences</a>
    <h1 class="h3 fw-bold mt-2 mb-4">{{ mode }}</h1>

    <div class="border rounded p-4">
        {{ form_start(form) }}
            {{ form_row(form.name) }}
            <div class="row">
                <div class="col-md-6">{{ form_row(form.skillGroup) }}</div>
                <div class="col-md-6">{{ form_row(form.level) }}</div>
            </div>
            <div class="row">
                <div class="col-md-6">{{ form_row(form.yearsOfExperience) }}</div>
                <div class="col-md-6">{{ form_row(form.position) }}</div>
            </div>
            {{ form_row(form.icon) }}
            {{ form_row(form.description) }}
            <div class="row">
                <div class="col-md-6">{{ form_row(form.visible) }}</div>
                <div class="col-md-6">{{ form_row(form.highlighted) }}</div>
            </div>
            <button class="btn btn-primary mt-3">Enregistrer</button>
            <a href="{{ url('back_skill_index') }}" class="btn btn-link">Annuler</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
