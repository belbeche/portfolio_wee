{% extends 'base_back.html.twig' %}

{% block title %}Prospects{% endblock %}
{% block breadcrumb %}Commercial{% endblock %}
{% block heading %}Prospects{% endblock %}

{% block topActions %}
	<a href="{{ url('back_prospect_new') }}" class="ad-btn ad-btn--primary">Ajouter un prospect</a>
{% endblock %}

{% block content %}

{# Compteurs du tunnel, pour savoir ou en est la prospection d'un coup d'oeil. #}
{% set aContacter = prospects|filter(p => p.status == 'a_contacter')|length %}
{% set relancesDues = prospects|filter(p => p.isFollowUpDue())|length %}
{% set enCours = prospects|filter(p => p.status in ['contacte','relance','rdv_pris','proposition'])|length %}
{% set gagnes = prospects|filter(p => p.status == 'gagne')|length %}

<div class="ad-kpis">
	<div class="ad-kpi" data-tone="light">
		<div class="ad-kpi__n">{{ prospects|length }}</div>
		<div class="ad-kpi__l">Au total</div>
	</div>
	<div class="ad-kpi ad-kpi--red" data-tone="light">
		<div class="ad-kpi__n">{{ relancesDues }}</div>
		<div class="ad-kpi__l">Relances dues</div>
		<div class="ad-kpi__hint">À traiter en priorité</div>
	</div>
	<div class="ad-kpi ad-kpi--gold" data-tone="light">
		<div class="ad-kpi__n">{{ aContacter }}</div>
		<div class="ad-kpi__l">À contacter</div>
	</div>
	<div class="ad-kpi ad-kpi--violet" data-tone="light">
		<div class="ad-kpi__n">{{ enCours }}</div>
		<div class="ad-kpi__l">En cours</div>
	</div>
	<div class="ad-kpi ad-kpi--green" data-tone="light">
		<div class="ad-kpi__n">{{ gagnes }}</div>
		<div class="ad-kpi__l">Gagnés</div>
	</div>
</div>

{# ------------------------------------------------ envois depuis le back office #}
<section class="ad-card" style="margin-bottom:1rem;" data-tone="light">
	<div class="ad-card__head">
		<h2>Envois</h2>
		<span class="ad-tag">Un e-mail à la fois · adresses vérifiées uniquement</span>
	</div>
	<div class="ad-card__body">
		<div style="display:flex;flex-wrap:wrap;gap:.8rem;align-items:center;">
			<button type="button" id="wb-envoi-premiers" class="ad-btn ad-btn--primary"
			        data-relances="0" {{ waveCandidates|length == 0 ? 'disabled' : '' }}>
				Envoyer les premiers contacts ({{ waveCandidates|length }})
			</button>

			<button type="button" id="wb-envoi-relances" class="ad-btn ad-btn--ghost"
			        data-relances="1" {{ dueFollowUps|length == 0 ? 'disabled' : '' }}>
				Envoyer les relances dues ({{ dueFollowUps|length }})
			</button>

			<button type="button" id="wb-envoi-stop" class="ad-btn ad-btn--danger" hidden>Arrêter</button>

			<form method="post" action="{{ path('back_prospect_smtp_check') }}" style="margin-left:auto;">
				<input type="hidden" name="_token" value="{{ csrf_token('prospect_smtp_check') }}">
				<button class="ad-btn ad-btn--ghost ad-btn--sm">Tester le serveur d'envoi</button>
			</form>
		</div>

		{# ------------------------------------------------- essai avant envoi reel #}
		<div style="margin-top:1rem;padding:1rem;border:1px dashed var(--ad-line, #dde5f0);border-radius:10px;">
			<div style="font-weight:600;font-size:.9rem;margin-bottom:.3rem;">
				D'abord, un essai sur ta propre boîte
			</div>
			<p style="margin:0 0 .8rem;font-size:.8rem;color:var(--ad-text-3);">
				Reçois les deux e-mails tels que les prospects les verront, avec l'offre PDF jointe.
				Aucun prospect n'est touché, aucun statut ne bouge.
			</p>
			<form method="post" action="{{ path('back_prospect_preview_emails') }}"
			      style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;">
				<input type="hidden" name="_token" value="{{ csrf_token('prospect_preview_emails') }}">
				<input type="email" name="destinataire" class="form-control"
				       style="flex:1 1 260px;min-width:0;max-width:340px;"
				       value="{{ app.user ? app.user.userIdentifier : '' }}"
				       placeholder="Adresse de réception de l'essai">
				<button class="ad-btn ad-btn--primary">M'envoyer les deux e-mails d'essai</button>
			</form>
		</div>

		<div id="wb-envoi-etat" hidden style="margin-top:1rem;padding:1rem;background:var(--ad-paper-2, #f6f8fb);border-radius:10px;">
			<div id="wb-envoi-ligne" style="font-weight:600;font-size:.92rem;"></div>
			<div id="wb-envoi-detail" style="font-size:.82rem;color:var(--ad-text-3);margin-top:.3rem;"></div>
			<div id="wb-envoi-echecs" style="font-size:.82rem;color:#c0392b;margin-top:.5rem;white-space:pre-line;"></div>
		</div>

		<p style="margin:.8rem 0 0;font-size:.78rem;color:var(--ad-text-3);">
			Les e-mails partent un par un, la page suit la progression en direct : plus aucun envoi
			ne peut être coupé en cours de route. Chaque envoi part de contact@walidbelbeche.fr avec
			une copie cachée vers ta boîte, alimente le journal du prospect à la seconde où il part,
			et pose la cadence J+4 puis J+10. Tu peux arrêter à tout moment, ce qui est parti reste tracé.
			Les adresses en « a-completer » sont toujours ignorées. Si rien ne part, clique
			« Tester le serveur d'envoi » : il dira précisément ce qui bloque.
		</p>
	</div>
</section>

<script>
(function () {
	var etat = document.getElementById('wb-envoi-etat');
	var ligne = document.getElementById('wb-envoi-ligne');
	var detail = document.getElementById('wb-envoi-detail');
	var echecs = document.getElementById('wb-envoi-echecs');
	var stop = document.getElementById('wb-envoi-stop');
	var arrete = false;

	function lancer(relances, bouton) {
		var total = 0, envoyes = 0, rates = 0;
		var echecsDeSuite = 0;    // trois echecs d'affilee = le serveur d'envoi
		                          // est en cause, on arrete au lieu de bruler
		                          // toute la liste contre un SMTP muet
		var tentes = [];          // ce qui a deja ete tente : jamais deux fois
		var PAUSE = 4000;         // 4 s entre deux envois : un SMTP mutualise
		                          // refuse les rafales (erreur 450 too much mail)
		arrete = false;
		etat.hidden = false;
		stop.hidden = false;
		bouton.disabled = true;
		echecs.textContent = '';
		ligne.textContent = 'Préparation…';

		function suivant() {
			if (arrete) {
				ligne.textContent = 'Arrêté. ' + envoyes + ' envoyé(s), ' + rates + ' échec(s).';
				stop.hidden = true; bouton.disabled = false;
				return;
			}
			var corps = new URLSearchParams();
			corps.set('_token', {{ csrf_token('prospect_send_wave')|json_encode|raw }});
			corps.set('relances', relances);
			tentes.forEach(function (id) { corps.append('tentes[]', id); });

			fetch({{ path('back_prospect_send_next')|json_encode|raw }}, {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				credentials: 'same-origin',
				body: corps.toString()
			}).then(function (r) { return r.json(); }).then(function (d) {
				if (d.id) { tentes.push(d.id); }

				if (d.stop) {
					ligne.textContent = 'Vague interrompue par le serveur d\'envoi.';
					detail.textContent = envoyes + ' parti(s) et tracé(s). Reprends plus tard, rien ne repartira deux fois.';
					echecs.textContent += (d.message || '') + '\n';
					stop.hidden = true; bouton.disabled = false;
					return;
				}
				if (d.fini) {
					ligne.textContent = 'Terminé : ' + envoyes + ' envoyé(s)' + (rates ? ', ' + rates + ' échec(s)' : '') + '.';
					detail.textContent = 'Recharge la page pour voir les statuts à jour.';
					stop.hidden = true; bouton.disabled = false;
					return;
				}

				if (d.ok) {
					envoyes++;
					echecsDeSuite = 0;
				} else {
					rates++;
					echecsDeSuite++;
					echecs.textContent += d.societe + ' : ' + (d.message || 'échec') + '\n';

					if (echecsDeSuite >= 3) {
						ligne.textContent = 'Arrêt : aucun e-mail ne part.';
						detail.textContent = 'Trois échecs d\'affilée, le problème vient du serveur d\'envoi et non des prospects. '
							+ 'Aucun des ' + rates + ' prospects tentés n\'a été marqué comme contacté, ils repartiront tels quels. '
							+ 'Clique « Tester le serveur d\'envoi » pour voir ce qui bloque.';
						stop.hidden = true; bouton.disabled = false;
						return;
					}
				}
				total = envoyes + rates + d.restants;
				ligne.textContent = 'Envoi ' + (envoyes + rates) + ' sur ' + total + ' · ' + d.societe;
				detail.textContent = envoyes + ' parti(s), ' + rates + ' échec(s), ' + d.restants + ' restant(s). Prochain envoi dans 4 s.';
				setTimeout(suivant, PAUSE);
			}).catch(function (e) {
				ligne.textContent = 'Interrompu : ' + e.message;
				detail.textContent = envoyes + ' e-mail(s) déjà partis et tracés. Recharge puis reclique pour continuer.';
				stop.hidden = true; bouton.disabled = false;
			});
		}
		suivant();
	}

	['wb-envoi-premiers', 'wb-envoi-relances'].forEach(function (id) {
		var b = document.getElementById(id);
		if (!b) { return; }
		b.addEventListener('click', function () {
			var quoi = b.dataset.relances === '1' ? 'les relances dues' : 'les premiers contacts avec l\'offre PDF jointe';
			if (!confirm('Envoyer ' + quoi + ' ? Tu peux arrêter à tout moment.')) { return; }
			lancer(b.dataset.relances, b);
		});
	});
	stop.addEventListener('click', function () { arrete = true; stop.hidden = true; });
})();
</script>

<section class="ad-card" data-tone="light">
	<div class="ad-card__head">
		<h2>Pipeline</h2>
		<span class="ad-tag">Cadence de relance J+4 puis J+10</span>
	</div>

	{% if prospects|length > 0 %}
		<table class="ad-table">
			<thead>
				<tr>
					<th>Société</th>
					<th>Contact</th>
					<th>Priorité</th>
					<th>Statut</th>
					<th>Échanges</th>
					<th>Prochaine relance</th>
					<th style="text-align:right;">Actions</th>
				</tr>
			</thead>
			<tbody>
			{% for prospect in prospects %}
				{% set due = prospect.isFollowUpDue() %}
				{% set dejaContacte = prospect.status != 'a_contacter' %}
				<tr>
					<td data-libelle="Société">
						<div>
							<strong>{{ prospect.company ?: prospect.email }}</strong>
							{% if prospect.city %}<div style="font-size:.78rem;color:var(--ad-text-3);">{{ prospect.city }}</div>{% endif %}
						</div>
					</td>
					<td data-libelle="Contact">
						<div>
							{{ prospect.contactName ?: '-' }}
							<div style="font-size:.78rem;color:var(--ad-text-3);">{{ prospect.email }}</div>
						</div>
					</td>
					<td data-libelle="Priorité">
						{% if prospect.priority %}
							<span class="ad-tag ad-tag--{{ prospect.priority == 'P1' ? 'green' : (prospect.priority == 'P2' ? 'gold' : 'muted') }}">{{ prospect.priority }}</span>
						{% else %}<span>-</span>{% endif %}
					</td>
					<td data-libelle="Statut">
						<span class="ad-tag ad-tag--{{ dejaContacte ? 'green' : 'blue' }}">{{ prospect.statusLabel }}</span>
					</td>
					<td class="num" data-libelle="Échanges"><span>{{ prospect.prospectNotes|length }}</span></td>
					<td data-libelle="Prochaine relance">
						{% if prospect.nextFollowUpAt %}
							<span class="ad-tag ad-tag--{{ due ? 'red' : 'gold' }}">
								{{ prospect.nextFollowUpAt|date('d/m/Y') }}
							</span>
						{% else %}
							<span class="ad-tag ad-tag--muted">aucune</span>
						{% endif %}
					</td>
					<td data-libelle="Actions">
						<div class="ad-actions">
							<a href="{{ path('back_prospect_notes', {id: prospect.id}) }}" class="ad-btn ad-btn--primary ad-btn--sm">Journal</a>
							<a href="{{ path('back_prospect_edit', {id: prospect.id}) }}" class="ad-btn ad-btn--ghost ad-btn--sm">Modifier</a>
							<form method="post" action="{{ path('back_prospect_delete', {id: prospect.id}) }}" style="display:inline;"
							      onsubmit="return confirm('Supprimer définitivement {{ (prospect.company ?: prospect.email)|e('js') }} et tout son journal ?');">
								<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ prospect.id) }}">
								<button class="ad-btn ad-btn--danger ad-btn--sm">Supprimer</button>
							</form>
						</div>
					</td>
				</tr>
			{% endfor %}
			</tbody>
		</table>
	{% else %}
		<div class="ad-card__body">
			<div class="ad-empty">
				<h3>Aucun prospect en base</h3>
				<p style="margin:0 0 1rem;font-size:.86rem;">
					Le pipeline est vide. Commence par les agences de l'Eure :
					ce sont les plus proches, et les plus faciles à qualifier.
				</p>
				<a href="{{ url('back_prospect_new') }}" class="ad-btn ad-btn--primary">Ajouter le premier</a>
			</div>
		</div>
	{% endif %}

	<div class="ad-card__foot" style="color:var(--ad-text-3);">
		Le point du matin en une commande : <code>php bin/console app:prospection:daily</code>
	</div>
</section>

{% endblock %}
