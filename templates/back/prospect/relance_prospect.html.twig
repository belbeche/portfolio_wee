{% extends 'emails/_layout.html.twig' %}

{% block email_title %}Je reviens vers vous{% endblock %}
{% block email_preview %}Une question rapide, et je vous laisse tranquille.{% endblock %}
{% block email_kicker %}Suite de mon message{% endblock %}

{% block email_hero %}
    <p style="margin:0 0 10px;font-family:Arial,Helvetica,sans-serif;font-size:24px;line-height:1.24;font-weight:bold;color:#ffffff;">
        Une question rapide,<br>
        <span style="color:#f5b301;">et je vous laisse tranquille.</span>
    </p>
    <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#a9bdd8;">
        Développement web et mobile en marque blanche, un seul interlocuteur.
    </p>
{% endblock %}

{% block email_body %}
    <p style="margin:0 0 16px;">
        Bonjour{% if prospect.contactName %} {{ prospect.contactName }}{% endif %},
    </p>

    <p style="margin:0 0 18px;">
        Je me permets de revenir vers vous suite à mon message
        {% if prospect.lastContactedAt %}du {{ prospect.lastContactedAt|date('d/m') }}{% endif %}.
        Je sais que ce genre d'e-mail arrive rarement au bon moment, alors je fais court.
    </p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="margin:0 0 20px;background-color:#f6f8fb;border-left:3px solid #f5b301;border-radius:0 8px 8px 0;">
        <tr>
            <td style="padding:16px 18px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#3a465c;">
                <strong style="color:#0a1628;">Avez-vous un projet en attente faute de temps de développement ?</strong><br>
                Si oui, quinze minutes au téléphone suffisent pour le chiffrer.
                Si non, répondez « pas maintenant » : je n'insisterai pas.
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 18px;">
        <tr>
            <td align="center" bgcolor="#0a1628" style="border-radius:8px;">
                <a href="https://walidbelbeche.fr/contact"
                   style="display:inline-block;padding:13px 26px;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#ffffff;text-decoration:none;">
                    En parler 15 minutes &rarr;
                </a>
            </td>
        </tr>
    </table>

    <p style="margin:0;font-size:13px;color:#7b8aa0;">
        Vous pouvez aussi m'appeler directement au <strong style="color:#0a1628;">06 61 28 77 86</strong>.
    </p>
{% endblock %}
