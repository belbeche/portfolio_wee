{% extends 'base_back.html.twig' %}

{% block title %}Blog{% endblock %}
{% block breadcrumb %}Contenu{% endblock %}
{% block heading %}Blog{% endblock %}

{% block topActions %}
	<a href="{{ path('admin_blog_create') }}" class="ad-btn ad-btn--primary">Écrire un article</a>
	<a href="{{ url('blog_index') }}" class="ad-btn ad-btn--ghost" target="_blank" rel="noopener">Voir le blog</a>
{% endblock %}

{% block content %}

{% set publies = posts|filter(p => p.status == 'published')|length %}
{% set brouillons = posts|length - publies %}

<div class="ad-kpis">
	<div class="ad-kpi" data-tone="light">
		<div class="ad-kpi__n">{{ posts|length }}</div>
		<div class="ad-kpi__l">Articles</div>
	</div>
	<div class="ad-kpi ad-kpi--green" data-tone="light">
		<div class="ad-kpi__n">{{ publies }}</div>
		<div class="ad-kpi__l">Publiés</div>
		<div class="ad-kpi__hint">Visibles sur le site</div>
	</div>
	<div class="ad-kpi ad-kpi--gold" data-tone="light">
		<div class="ad-kpi__n">{{ brouillons }}</div>
		<div class="ad-kpi__l">Brouillons</div>
		<div class="ad-kpi__hint">Invisibles pour vos visiteurs</div>
	</div>
</div>

<section class="ad-card" data-tone="light">
	<div class="ad-card__head">
		<h2>Vos articles</h2>
		<span class="ad-tag">Chaque article répond à une question que vos prospects tapent dans Google</span>
	</div>

	{% if posts|length > 0 %}
		<table class="ad-table">
			<thead>
				<tr>
					<th>Titre</th>
					<th style="width:150px;">Sujet</th>
					<th style="width:120px;">Publié le</th>
					<th style="width:110px;">Langues</th>
					<th style="width:120px;">Statut</th>
					<th style="width:260px;text-align:right;">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for post in posts %}
					<tr>
						<td data-libelle="Titre">
							<div class="ad-cell-clip"><strong>{{ post.title }}</strong></div>
							{% if post.slug %}
								<div style="font-size:.76rem;color:var(--ad-text-3);">/blog/{{ post.slug }}</div>
							{% endif %}
						</td>
						<td>
							{% if post.category %}
								<span class="ad-tag ad-tag--blue">{{ post.category.name }}</span>
							{% else %}
								<span class="ad-tag ad-tag--muted">aucun</span>
							{% endif %}
						</td>
						<td>{{ post.createdAt ? post.createdAt|date('d/m/Y') : '-' }}</td>
						<td data-libelle="Langues">
							<span class="ad-tag ad-tag--muted">FR</span>
							{% if post.hasEnglishVersion() %}
								<span class="ad-tag ad-tag--green">EN</span>
							{% endif %}
						</td>
						<td data-libelle="Statut">
							{% if post.status == 'published' %}
								<span class="ad-tag ad-tag--green">Publié</span>
							{% elseif post.status == 'draft' %}
								<span class="ad-tag ad-tag--muted">Brouillon</span>
							{% else %}
								<span class="ad-tag ad-tag--gold">{{ post.status|capitalize }}</span>
							{% endif %}
						</td>
						<td style="text-align:right;white-space:nowrap;">
							{% if post.status == 'published' %}
								<a href="{{ url('blog_show', {slug: post.slug}) }}" class="ad-btn ad-btn--ghost ad-btn--sm"
								   target="_blank" rel="noopener">Voir</a>
							{% else %}
								<form method="post" action="{{ path('admin_blog_validate', { id: post.id }) }}" style="display:inline;">
									<input type="hidden" name="_token" value="{{ csrf_token('validate' ~ post.id) }}">
									<button class="ad-btn ad-btn--primary ad-btn--sm">Publier</button>
								</form>
							{% endif %}
							<a href="{{ path('admin_blog_edit', { id: post.id }) }}" class="ad-btn ad-btn--ghost ad-btn--sm">Modifier</a>
							<form method="post" action="{{ path('admin_blog_delete', { id: post.id }) }}" style="display:inline;"
							      onsubmit="return confirm('Supprimer définitivement « {{ post.title|e('js') }} » ?');">
								<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
								<button class="ad-btn ad-btn--danger ad-btn--sm">Supprimer</button>
							</form>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<div class="ad-card__body">
			<div class="ad-empty">
				<h3>Aucun article pour le moment</h3>
				<p style="margin:0 0 1rem;font-size:.86rem;">
					Le blog est une porte d'entrée pour le référencement : chaque article répond à une
					question que vos prospects tapent dans Google, et vous ramène des visiteurs sans publicité.
				</p>
				<a href="{{ path('admin_blog_create') }}" class="ad-btn ad-btn--primary">Écrire le premier</a>
			</div>
		</div>
	{% endif %}
</section>

{% endblock %}
