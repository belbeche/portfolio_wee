{% extends 'base_back.html.twig' %}

{% block title %}Paramètres{% endblock %}

{% block content %}

{# --------------------------------------------------- purge du navigateur --
   Vider le cache du serveur ne sert a rien si le navigateur ressert sa
   copie, et le service worker de la PWA garde lui aussi les fichiers.
   Cette sequence supprime les deux, puis recharge la page proprement. #}
{% if app.request.query.get('rechargement') %}
<div class="ad-card" style="margin-bottom:1rem;border-color:#f5b301;" data-tone="light">
    <div class="ad-card__body" style="display:flex;align-items:center;gap:.7rem;">
        <span class="ad-tag ad-tag--gold">en cours</span>
        <span id="wb-purge-etat" style="font-size:.9rem;">Purge du cache de ce navigateur, puis rechargement…</span>
    </div>
</div>
<script nonce="{{ csp_nonce() }}">
(function () {
	var etat = document.getElementById('wb-purge-etat');
	var propre = {{ path('back_settings')|json_encode|raw }} + '?vide=1';

	function dire(t) { if (etat) { etat.textContent = t; } }

	function terminer() {
		dire('Rechargement…');
		// replace et non href : le bouton Retour ne rejoue pas la purge.
		setTimeout(function () { window.location.replace(propre); }, 350);
	}

	var travaux = [];

	// 1. Le Cache Storage de la PWA, qui sert les fichiers hors ligne.
	if (window.caches && caches.keys) {
		travaux.push(caches.keys().then(function (noms) {
			return Promise.all(noms.map(function (n) { return caches.delete(n); }));
		}).catch(function () {}));
	}

	// 2. Le service worker lui-meme : on lui demande sa version a jour.
	if (navigator.serviceWorker && navigator.serviceWorker.getRegistrations) {
		travaux.push(navigator.serviceWorker.getRegistrations().then(function (regs) {
			return Promise.all(regs.map(function (r) { return r.update().catch(function () {}); }));
		}).catch(function () {}));
	}

	// Filet de securite : si une promesse ne revient jamais, on recharge quand meme.
	var secours = setTimeout(terminer, 3500);
	Promise.all(travaux).then(function () { clearTimeout(secours); terminer(); });
})();
</script>
{% elseif app.request.query.get('vide') %}
<div class="ad-card" style="margin-bottom:1rem;border-color:#35d07f;" data-tone="light">
    <div class="ad-card__body" style="display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;">
        <span class="ad-tag ad-tag--green">terminé</span>
        <span style="font-size:.9rem;">
            Cache du serveur vidé, cache de ce navigateur et service worker purgés,
            page rechargée. Tu regardes bien la dernière version.
        </span>
    </div>
</div>
{% endif %}

<div class="ad-head">
    <div>
        <h1 class="ad-title">Paramètres de l'application</h1>
        <p class="ad-sub">
            Ces valeurs vivent en base de données : un déploiement ne peut pas les écraser,
            et une modification prend effet immédiatement.
        </p>
    </div>
</div>

<div class="ad-card" style="max-width: 860px;">
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('app_settings') }}">

        {% for row in rows %}
            <div style="margin-bottom: 1.6rem;">
                <label class="form-label fw-bold" for="set-{{ row.name }}">
                    {{ row.label }}
                    {% if row.hasValue %}
                        <span class="badge {{ row.fromEnv ? 'bg-secondary' : 'bg-success' }}" style="font-size:.68rem;">
                            {{ row.fromEnv ? 'valeur du .env (repli)' : 'enregistré en base' }}
                        </span>
                    {% else %}
                        <span class="badge bg-warning text-dark" style="font-size:.68rem;">à renseigner</span>
                    {% endif %}
                </label>

                {% if row.secret %}
                    <input type="password" class="form-control" id="set-{{ row.name }}" name="{{ row.name }}"
                           value="" autocomplete="new-password"
                           placeholder="{{ row.hasValue ? '••••••••  (laisser vide pour conserver la valeur actuelle)' : 'Saisir le jeton' }}">
                {% else %}
                    <input type="text" class="form-control" id="set-{{ row.name }}" name="{{ row.name }}"
                           value="{{ row.stored ?? '' }}">
                {% endif %}

                <div class="form-text">{{ row.help }}</div>
            </div>
        {% endfor %}

        <button type="submit" class="ad-btn ad-btn--primary">Enregistrer</button>
    </form>
</div>

<div class="ad-card" style="margin-top:1rem;" data-tone="light">
    <div class="ad-card__head"><h2>Cache des visiteurs</h2></div>
    <div class="ad-card__body">
        <p style="margin:0 0 .8rem;font-size:.85rem;color:var(--ad-text-3);">
            Après un déploiement, les navigateurs et Cloudflare peuvent garder les anciens
            CSS et scripts. Ce bouton change la version des fichiers statiques : tout le monde
            recharge les derniers fichiers à sa prochaine visite, sans rien faire de son côté.
        </p>
        <form method="post" action="{{ path('back_settings_purge') }}"
              onsubmit="return confirm('Forcer tous les visiteurs à recharger les fichiers statiques ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_purge') }}">
            <button class="ad-btn ad-btn--primary">Forcer l'actualisation des visiteurs</button>
        </form>

        <hr style="margin:1.2rem 0;border:0;border-top:1px dashed var(--ad-line, #dde5f0);">

        <p style="margin:0 0 .8rem;font-size:.85rem;color:var(--ad-text-3);">
            <strong style="color:var(--ad-text);">Le cache du serveur.</strong>
            Après un déploiement, les gabarits et les traductions restent parfois figés sur
            leur ancienne version. Ce bouton les vide sans passer par la console, et
            incrémente aussi la version des fichiers statiques dans la foulée.
        </p>
        <form method="post" action="{{ path('back_settings_clear_cache') }}"
              onsubmit="return confirm('Vider le cache du serveur (gabarits, traductions, données mises en cache) ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_clear_cache') }}">
            <button class="ad-btn ad-btn--primary">Vider le cache du serveur</button>
        </form>
    </div>
</div>

<div class="ad-card" style="margin-top:1rem;" data-tone="light">
    <div class="ad-card__head"><h2>Notifications push</h2></div>
    <div class="ad-card__body">
        <p style="margin:0 0 .8rem;font-size:.85rem;color:var(--ad-text-3);">
            Les clés VAPID se génèrent toutes seules au premier abonnement. Pour t'abonner :
            ouvre l'espace client et clique « Activer les notifications ». Ensuite ce bouton
            envoie un essai à tous les navigateurs abonnés. Envoi manuel possible aussi :
            <code style="font-size:.78rem;">php bin/console app:push:envoyer "Titre" "Message" --url=/espace</code>
        </p>
        <form method="post" action="{{ path('back_settings_push_test') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_push_test') }}">
            <button class="ad-btn ad-btn--primary">M'envoyer une notification d'essai</button>
        </form>
    </div>
</div>
{% endblock %}
