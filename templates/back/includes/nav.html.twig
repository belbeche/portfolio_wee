{#
	Barre laterale d'administration.

	Groupee par domaine plutot qu'en liste plate : commercial, contenu,
	relation client, configuration. Un menu de douze liens sans hierarchie
	oblige a lire les douze pour en trouver un.

	Les compteurs viennent de la fonction Twig admin_counts(), calculee
	une seule fois par requete et tolerante aux tables absentes.
#}

{% set r = app.request.get('_route') %}
{% set counts = admin_counts() %}

<aside class="ad-side" id="ad-side">

	<div class="ad-brand">
		<span class="ad-brand__mark">WB</span>
		<span class="ad-brand__txt">
			<b>Administration</b>
			<span>walidbelbeche.fr</span>
		</span>
	</div>

	<nav class="ad-nav">

		<div class="ad-nav__group">
			<a href="{{ url('back_index') }}" class="ad-nav__link {{ r == 'back_index' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>
				Tableau de bord
			</a>
		</div>

		<div class="ad-nav__group">
			<div class="ad-nav__label">Commercial</div>

			<a href="{{ url('back_devis_index') }}" class="ad-nav__link {{ r starts with 'back_devis' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>
				Devis
				{% if counts.devis is defined and counts.devis %}<span class="ad-nav__count">{{ counts.devis }}</span>{% endif %}
			</a>

			<a href="{{ url('back_callback_requests') }}" class="ad-nav__link {{ r starts with 'back_callback' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .4 1.9.7 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.2a2 2 0 012.1-.5c.9.3 1.8.6 2.8.7a2 2 0 011.7 2z"/></svg>
				Demandes de rappel
				{% if counts.callbacks is defined and counts.callbacks %}<span class="ad-nav__count ad-nav__count--alert">{{ counts.callbacks }}</span>{% endif %}
			</a>

			<a href="{{ url('back_prospect_index') }}" class="ad-nav__link {{ r starts with 'back_prospect' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.9M16 3.1a4 4 0 010 7.8"/></svg>
				Prospects
				{% if counts.prospects is defined and counts.prospects %}<span class="ad-nav__count">{{ counts.prospects }}</span>{% endif %}
			</a>

			<a href="{{ url('back_contact_show') }}" class="ad-nav__link {{ r starts with 'back_contact' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z"/><path d="M22 6l-10 7L2 6"/></svg>
				Messages de contact
			</a>
		</div>

		<div class="ad-nav__group">
			<div class="ad-nav__label">Contenu</div>

			<a href="{{ url('back_project_index') }}" class="ad-nav__link {{ r starts with 'back_project' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M2 7l10-5 10 5-10 5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
				Réalisations
				{% if counts.projects is defined and counts.projects %}<span class="ad-nav__count">{{ counts.projects }}</span>{% endif %}
			</a>

			<a href="{{ url('back_skill_index') }}" class="ad-nav__link {{ r starts with 'back_skill' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M12 2l2.6 6.3 6.9.5-5.3 4.4 1.7 6.7L12 16.3 6.1 19.9l1.7-6.7L2.5 8.8l6.9-.5z"/></svg>
				Compétences
				{% if counts.skills is defined and counts.skills %}<span class="ad-nav__count">{{ counts.skills }}</span>{% endif %}
			</a>

			<a href="{{ url('admin_blog_index') }}" class="ad-nav__link {{ r starts with 'admin_blog' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
				Blog
			</a>

			<a href="{{ url('back_category_index') }}" class="ad-nav__link {{ r starts with 'back_category' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M20.6 13.4L11 3.8V2H3v8h1.8l9.6 9.6a2 2 0 002.8 0l3.4-3.4a2 2 0 000-2.8z"/><circle cx="7" cy="7" r="1.2"/></svg>
				Catégories
			</a>
		</div>

		<div class="ad-nav__group">
			<div class="ad-nav__label">Relation client</div>

			<a href="{{ url('back_ticket') }}" class="ad-nav__link {{ r starts with 'back_ticket' or r starts with 'back_show_ticket' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
				Tickets
				{% if counts.tickets is defined and counts.tickets %}<span class="ad-nav__count ad-nav__count--alert">{{ counts.tickets }}</span>{% endif %}
			</a>

			<a href="{{ url('back_home_support') }}" class="ad-nav__link {{ r starts with 'back_subjects' or r == 'back_home_support' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 015.8 1c0 2-3 3-3 3M12 17h.01"/></svg>
				Forum et support
			</a>

			<a href="{{ url('back_comments_list') }}" class="ad-nav__link {{ r starts with 'back_comments' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.4 8.4 0 01-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.4 8.4 0 013.8-.9h.5a8.5 8.5 0 018 8z"/></svg>
				Commentaires
			</a>

			<a href="{{ url('back_review_index') }}" class="ad-nav__link {{ r starts with 'back_review' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
				Avis clients
			</a>
		</div>

		<div class="ad-nav__group">
			<div class="ad-nav__label">Configuration</div>

			<a href="{{ url('back_user_index') }}" class="ad-nav__link {{ r starts with 'back_user' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
				Utilisateurs
				{% if counts.users is defined and counts.users %}<span class="ad-nav__count">{{ counts.users }}</span>{% endif %}
			</a>

			<a href="{{ url('back_member_index') }}" class="ad-nav__link {{ r starts with 'back_member' ? 'is-active' }}">
				<svg class="ad-nav__ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
				Équipe
			</a>
		</div>

	</nav>

	<div class="ad-side__foot">
		<img src="{{ app.user and app.user.avatar ? asset('uploads/avatar/' ~ app.user.avatar) : asset('uploads/avatar/support0.svg') }}"
		     alt="{{ app.user ? app.user.username : '' }}">
		<span>
			<b>{{ app.user ? (app.user.prenom ?: app.user.username) : '' }}</b>
			<span>Administrateur</span>
		</span>
	</div>

</aside>
