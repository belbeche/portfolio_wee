{% extends 'base.html.twig' %}

{% block title %}Choisir un nouveau mot de passe | Walid BELBECHE{% endblock %}
{% block meta_description %}Choisissez le nouveau mot de passe de votre espace client.{% endblock %}

{% block content %}

<section class="wb-hero wb-slant" data-tone="dark" style="padding-bottom:6rem;">
	<div class="container">
		<div class="row justify-content-center text-center">
			<div class="col-lg-7">
				<span class="wb-eyebrow">Dernière étape</span>
				<h1 class="wb-display">Votre nouveau<br><span class="wb-mark">mot de passe</span></h1>
				<p class="wb-lead wb-lead--on-dark mx-auto mb-0">
					Choisissez-en un, validez, et vous êtes connecté.
				</p>
			</div>
		</div>
	</div>
</section>

<section class="wb-section" data-tone="light">
	<div class="container" style="max-width:620px;">

		{% for type, messages in app.flashes %}
			{% for message in messages %}
				<div class="wb-flash wb-flash--{{ type }}" style="margin-bottom:1.2rem;">{{ message }}</div>
			{% endfor %}
		{% endfor %}

		<div class="wb-card wb-form" data-tone="light">
			<form method="post" novalidate>
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
				<div class="mb-3">
					<label for="password" class="form-label">Nouveau mot de passe</label>
					<input type="password" class="form-control" id="password" name="password"
					       required minlength="12" autocomplete="new-password" autofocus>
					<div class="form-text">
						Douze caractères minimum. Une phrase entière que vous seul retenez
						protège mieux qu'un mot court plein de symboles, et elle se tape
						sans hésiter.
					</div>
				</div>
				<button type="submit" class="wb-btn wb-btn--gold w-100">Enregistrer et me connecter</button>
			</form>
		</div>

		<p class="text-center" style="margin-top:1.6rem; font-size:.92rem;">
			Ce lien ne fonctionne qu'une fois. S'il a expiré,
			<a href="{{ path('request_reset_password') }}">redemandez-en un</a>.
		</p>

	</div>
</section>

{% endblock %}
