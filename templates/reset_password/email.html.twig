{% extends 'emails/_layout.html.twig' %}

{% block email_title %}Réinitialisation de votre mot de passe{% endblock %}

{% block email_preview %}Votre lien de réinitialisation, valable une heure.{% endblock %}
{% block email_kicker %}Sécurité{% endblock %}

{% block email_hero %}
    <p style="margin:0 0 10px;font-family:Arial,Helvetica,sans-serif;font-size:25px;line-height:1.22;font-weight:bold;color:#ffffff;">
        Réinitialiser<br><span style="color:#f5b301;">votre mot de passe</span>
    </p>
    <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#a9bdd8;">
        Vous avez demandé un nouveau mot de passe. Le lien ci-dessous est valable une heure.
    </p>
{% endblock %}

{% block email_body %}
    <p style="margin:0 0 14px;">Bonjour,</p>
    <p style="margin:0 0 14px;">
        Une réinitialisation de mot de passe a été demandée pour votre compte
        sur walidbelbeche.fr. Le lien ci-dessous est valable une heure et ne
        sert qu'une fois.
    </p>
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px auto;">
        <tr>
            <td style="border-radius:8px;background-color:#0a1628;">
                <a href="{{ resetLink }}"
                   style="display:inline-block;padding:12px 28px;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#ffffff;text-decoration:none;">
                    Choisir un nouveau mot de passe
                </a>
            </td>
        </tr>
    </table>
    <p style="margin:0;font-size:13px;color:#6b7280;">
        Si vous n'êtes pas à l'origine de cette demande, ignorez cet e-mail :
        votre mot de passe actuel reste inchangé.
    </p>
{% endblock %}
