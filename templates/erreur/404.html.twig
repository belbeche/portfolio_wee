{% extends 'base.html.twig' %}

{% block title %}{{ app.request.locale == 'en' ? 'Page not found' : 'Page introuvable' }}{% endblock %}

{% block content %}
{% set en = app.request.locale == 'en' %}

<section class="wb-section wb-section--paper" data-tone="light" style="min-height:62vh;">
    <div class="container" style="max-width:680px;padding-top:4rem;">
        <div class="wb-card text-center" data-tone="light" style="padding:2.6rem 2rem;">
            <span class="wb-eyebrow wb-eyebrow--ink">{{ en ? 'Error 404' : 'Erreur 404' }}</span>
            <h1 class="wb-h2" style="margin:.5rem 0 .8rem;">{{ en ? 'This page does not exist' : "Cette page n'existe pas" }}</h1>
            <p style="color:var(--wb-text-2);max-width:520px;margin:0 auto 1.6rem;">
                {{ en ? 'The address may be mistyped, or the page has moved. Everything else is still where you left it.' : "L'adresse est peut-être mal orthographiée, ou la page a été déplacée. Le reste du site fonctionne normalement." }}
            </p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a href="{{ url('front_home') }}" class="wb-btn wb-btn--ink">{{ en ? 'Back to home' : "Retour à l'accueil" }}</a>
                <a href="{{ url('front_project') }}" class="wb-btn wb-btn--outline">{{ en ? 'See my work' : 'Voir mes réalisations' }}</a>
                <a href="{{ url('front_contact') }}" class="wb-btn wb-btn--outline">{{ en ? 'Contact me' : 'Me contacter' }}</a>
            </div>
        </div>
    </div>
</section>

{% endblock %}
