{% extends 'base.html.twig' %}

{% block title %}{{ app.request.locale == 'en' ? 'Something went wrong' : "Une erreur s'est produite" }}{% endblock %}

{% block content %}
{% set en = app.request.locale == 'en' %}

<section class="wb-section wb-section--paper" data-tone="light" style="min-height:62vh;">
    <div class="container" style="max-width:680px;padding-top:4rem;">
        <div class="wb-card text-center" data-tone="light" style="padding:2.6rem 2rem;">
            <span class="wb-eyebrow wb-eyebrow--ink">{{ en ? 'Unexpected error' : 'Erreur inattendue' }}</span>
            <h1 class="wb-h2" style="margin:.5rem 0 .8rem;">{{ en ? 'Something went wrong on my side' : "Quelque chose a échoué de mon côté" }}</h1>
            <p style="color:var(--wb-text-2);max-width:520px;margin:0 auto 1.6rem;">
                {{ en ? 'Not your fault. The incident is logged and I look at it. Try again in a moment, or tell me what you were doing.' : "Ce n'est pas de votre fait. L'incident est enregistré et je le regarde. Réessayez dans un instant, ou dites-moi ce que vous étiez en train de faire." }}
            </p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a href="{{ url('front_home') }}" class="wb-btn wb-btn--ink">{{ en ? 'Back to home' : "Retour à l'accueil" }}</a>
                <a href="{{ url('front_project') }}" class="wb-btn wb-btn--outline">{{ en ? 'See my work' : 'Voir mes réalisations' }}</a>
                <a href="{{ url('front_contact') }}" class="wb-btn wb-btn--outline">{{ en ? 'Contact me' : 'Me contacter' }}</a>
            </div>
        </div>
    </div>
</section>

{% endblock %}
