<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex, nofollow">
	<title>{% block title %}Administration{% endblock %} · Walid BELBECHE</title>

	<link rel="icon" type="image/png" sizes="32x32" href="{{ asset('medias/favicon/favicon-32x32.png') }}">
	<link rel="icon" href="{{ asset('medias/favicon/favicon.ico') }}">

	{# Bootstrap sert encore aux grilles et aux composants de formulaire des
	   pages existantes. Le systeme d'administration se charge apres et
	   reprend la main sur l'apparence. #}
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

	{% block stylesheets %}{% endblock %}

	<link rel="stylesheet" href="{{ asset('src/css/wb-admin.css') }}?v=11">
</head>
<body class="admin">

<div class="ad-shell">

	{% block sidebar %}
		{% include 'back/includes/nav.html.twig' %}
	{% endblock %}

	<div class="ad-main">

		<header class="ad-top">
			<button type="button" class="ad-burger" id="ad-burger" aria-label="Ouvrir le menu">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M3 6h18M3 12h18M3 18h18"/>
				</svg>
			</button>

			<div>
				<div class="ad-top__crumb">{% block breadcrumb %}Administration{% endblock %}</div>
				<h1 class="ad-top__title">{% block heading %}{{ block('title') }}{% endblock %}</h1>
			</div>

			<div class="ad-top__actions">
				{% block topActions %}{% endblock %}
				<a href="{{ url('front_home') }}" class="ad-btn ad-btn--ghost" target="_blank" rel="noopener">
					Voir le site
				</a>
				<a href="{{ url('app_logout') }}" class="ad-btn ad-btn--danger">Déconnexion</a>
			</div>
		</header>

		<main class="ad-body">
			{% for type, messages in app.flashes %}
				{% for message in messages %}
					<div class="ad-flash ad-flash--{{ type }}">{{ message }}</div>
				{% endfor %}
			{% endfor %}

			{% block content %}{% endblock %}
		</main>

	</div>
</div>

<div class="ad-backdrop" id="ad-backdrop"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
<script>
	(function () {
		var side = document.getElementById('ad-side');
		var burger = document.getElementById('ad-burger');
		var backdrop = document.getElementById('ad-backdrop');
		if (!side || !burger) { return; }

		function toggle(open) {
			side.classList.toggle('is-open', open);
			backdrop.classList.toggle('is-open', open);
		}
		burger.addEventListener('click', function () { toggle(!side.classList.contains('is-open')); });
		backdrop.addEventListener('click', function () { toggle(false); });
		document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { toggle(false); } });
	})();
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
