{% extends 'emails/_layout.html.twig' %}

{% block email_title %}Je vous rappelle très vite{% endblock %}

{% block email_body %}
    <p style="margin:0 0 14px;">Bonjour{% if name %} {{ name }}{% endif %},</p>
    <p style="margin:0 0 14px;">
        Votre demande de rappel est bien notée. Je vous appelle au
        <strong style="color:#141c2e;">{{ phone }}</strong> sous 24 heures ouvrées.
    </p>
    <p style="margin:0 0 14px;">
        Pas besoin de préparer quoi que ce soit : quelques minutes suffisent pour
        comprendre votre besoin et vous dire honnêtement si je suis la bonne personne.
    </p>
    <p style="margin:0;font-size:13px;color:#6b7280;">
        Numéro erroné ou créneau à préciser ? Répondez simplement à cet e-mail.
    </p>
{% endblock %}
