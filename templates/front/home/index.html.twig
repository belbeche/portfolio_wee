{# ------------------------------------------------------------- portail --
   L'ecran d'entree. Il se leve tout seul apres l'animation, ou des que le
   visiteur choisit une porte. Reglable dans l'administration :
   « non » l'eteint, « visite » le montre une fois par visite (defaut),
   « toujours » le remontre a chaque chargement de l'accueil.
   Il n'est jamais montre a quelqu'un qui arrive avec une ancre (#equipe),
   ni si le systeme demande moins d'animations. ------------------------- #}
{% set portailMode = settings.get('portail_accueil', 'visite')|lower %}
{% if portailMode != 'non' %}
<div id="wb-portail" class="wb-portail" data-mode="{{ portailMode }}" hidden>
    <div class="wb-portail__fond" aria-hidden="true"></div>

    <div class="wb-portail__inner" role="dialog" aria-modal="true" aria-label="{{ en ? 'Welcome' : 'Bienvenue' }}">

        <div class="wb-portail__sceau" aria-hidden="true">
            <span>WB</span>
        </div>

        <p class="wb-portail__sur">{{ en ? 'Walid Belbeche' : 'Walid Belbeche' }}</p>
        <p class="wb-portail__titre">
            {{ en ? 'Web and mobile applications,' : 'Applications web et mobiles,' }}<br>
            <em>{{ en ? 'one single contact.' : 'un seul interlocuteur.' }}</em>
        </p>
        <p class="wb-portail__sous">
            {{ en ? 'Where would you like to start?' : 'Par où souhaitez-vous commencer ?' }}
        </p>

        <div class="wb-portail__portes">
            <a href="{{ url('front_project') }}" class="wb-portail__porte" style="--wb-delay: 0ms;">
                <span class="wb-portail__porte-n">01</span>
                <strong>{{ en ? 'See real work' : 'Voir du concret' }}</strong>
                <span class="wb-portail__porte-d">{{ en ? 'Delivered projects, sorted by line of business.' : 'Des projets livrés, triés par secteur.' }}</span>
            </a>
            <a href="{{ url('front_devis_new') }}" class="wb-portail__porte" style="--wb-delay: 90ms;">
                <span class="wb-portail__porte-n">02</span>
                <strong>{{ en ? 'Price my idea' : 'Chiffrer mon idée' }}</strong>
                <span class="wb-portail__porte-d">{{ en ? 'Two minutes, an answer within 48 working hours.' : 'Deux minutes, une réponse sous 48 h ouvrées.' }}</span>
            </a>
            <a href="{{ url('front_commencer') }}" class="wb-portail__porte" style="--wb-delay: 180ms;">
                <span class="wb-portail__porte-n">03</span>
                <strong>{{ en ? 'Guide me' : 'Me laisser guider' }}</strong>
                <span class="wb-portail__porte-d">{{ en ? 'Not sure where to start? One minute tour.' : 'Pas sûr de par où commencer ? Visite en une minute.' }}</span>
            </a>
        </div>

        <button type="button" id="wb-portail-entrer" class="wb-portail__entrer">
            {{ en ? 'Enter the site' : 'Entrer sur le site' }}
            <span class="wb-portail__barre" aria-hidden="true"><i></i></span>
        </button>
    </div>
</div>

<script>
(function () {
	var portail = document.getElementById('wb-portail');
	if (!portail) { return; }

	var mode = portail.dataset.mode || 'visite';
	var CLE = 'wb_portail_vu';

	// Trois raisons de ne jamais le montrer : le visiteur arrive sur une
	// ancre precise, il demande moins d'animations, ou il l'a deja vu
	// pendant cette visite. Dans ces cas la page s'affiche directement.
	var arriveeCiblee = window.location.hash.length > 1;
	var moinsDAnimations = window.matchMedia
		&& window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	var dejaVu = false;
	try { dejaVu = 'visite' === mode && !!sessionStorage.getItem(CLE); } catch (e) {}

	if (arriveeCiblee || moinsDAnimations || dejaVu) { return; }

	var minuteur = null;

	function lever() {
		if (portail.classList.contains('is-sortie')) { return; }
		portail.classList.add('is-sortie');
		document.documentElement.classList.remove('wb-portail-ouvert');
		clearTimeout(minuteur);
		try { sessionStorage.setItem(CLE, '1'); } catch (e) {}
		// On retire l'element du flux une fois la transition finie, sinon il
		// continue d'intercepter les clics au-dessus de la page.
		setTimeout(function () { portail.hidden = true; }, 900);
	}

	document.documentElement.classList.add('wb-portail-ouvert');
	portail.hidden = false;
	// Force un cycle de rendu avant d'animer, sinon le navigateur applique
	// l'etat final directement et l'entree ne se voit pas.
	requestAnimationFrame(function () {
		requestAnimationFrame(function () { portail.classList.add('is-visible'); });
	});

	document.getElementById('wb-portail-entrer').addEventListener('click', lever);
	portail.addEventListener('click', function (e) { if (e.target === portail || e.target.classList.contains('wb-portail__fond')) { lever(); } });
	document.addEventListener('keydown', function (e) { if ('Escape' === e.key) { lever(); } });
	portail.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', lever); });
	// Le premier defilement vaut acceptation : personne ne doit se sentir
	// bloque par un ecran qu'il n'a pas demande.
	window.addEventListener('wheel', lever, { passive: true, once: true });
	window.addEventListener('touchmove', lever, { passive: true, once: true });
	// Filet de securite : au bout de 7 secondes le portail se leve seul.
	minuteur = setTimeout(lever, 7000);
})();
</script>
{% endif %}

