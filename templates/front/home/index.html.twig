{# ------------------------------------------------------- mise en scene -- #}
{# Tout est pose par le script, jamais par le gabarit : si le JavaScript ne
   s'execute pas, ou si le visiteur demande moins d'animations, la page reste
   entierement lisible et rien n'est masque. C'est la seule facon d'animer
   sans risquer une page blanche. #}
<script>
(function () {
	var moinsDAnimations = window.matchMedia
		&& window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (moinsDAnimations || !('IntersectionObserver' in window)) { return; }

	// 1. L'arrivee : le heros se compose en cascade, de haut en bas.
	var heros = document.querySelector('.wb-hero');
	if (heros) {
		var pieces = heros.querySelectorAll('.wb-eyebrow, .wb-display, .wb-lead, .d-flex, .wb-credential, .wb-card');
		Array.prototype.forEach.call(pieces, function (n, i) {
			n.style.setProperty('--wb-delay', (i * 110) + 'ms');
			n.classList.add('wb-entree');
		});
		requestAnimationFrame(function () {
			requestAnimationFrame(function () { heros.classList.add('is-entre'); });
		});
	}

	// 2. Le defilement : chaque bloc se leve une fois, quand il arrive.
	var cibles = document.querySelectorAll(
		'.wb-section .row, .wb-card, .wb-anecdote, .wb-stat, .wb-team__card, .wb-live__tile, .wb-skill'
	);
	if (!cibles.length) { return; }

	var observateur = new IntersectionObserver(function (entrees) {
		entrees.forEach(function (e) {
			if (!e.isIntersecting) { return; }
			e.target.classList.add('is-in');
			observateur.unobserve(e.target);
		});
	}, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });

	Array.prototype.forEach.call(cibles, function (n) {
		// Deja visible au chargement : on ne l'anime pas, sinon le premier
		// ecran clignote avant meme que la page soit lue.
		if (n.getBoundingClientRect().top < window.innerHeight * 0.9) {
			n.classList.add('is-in');

			return;
		}
		n.classList.add('wb-reveal');
		observateur.observe(n);
	});

	// 3. Les compteurs de la bande de chiffres montent quand on les atteint.
	var chiffres = document.querySelectorAll('.wb-stat__n');
	Array.prototype.forEach.call(chiffres, function (n) {
		var brut = n.textContent.trim();
		var cible = parseFloat(brut.replace(/[^0-9.,]/g, '').replace(',', '.'));
		if (!isFinite(cible) || cible <= 0) { return; }
		var suffixe = brut.replace(/[0-9.,\s]/g, '');
		var vu = false;
		var o = new IntersectionObserver(function (entrees) {
			entrees.forEach(function (e) {
				if (!e.isIntersecting || vu) { return; }
				vu = true;
				o.unobserve(e.target);
				var debut = null;
				function pas(t) {
					if (null === debut) { debut = t; }
					var k = Math.min(1, (t - debut) / 900);
					k = 1 - Math.pow(1 - k, 3);
					n.textContent = Math.round(cible * k) + (suffixe ? ' ' + suffixe : '');
					if (k < 1) { requestAnimationFrame(pas); }
				}
				n.textContent = '0' + (suffixe ? ' ' + suffixe : '');
				requestAnimationFrame(pas);
			});
		}, { threshold: 0.5 });
		o.observe(n);
	});
})();
</script>

