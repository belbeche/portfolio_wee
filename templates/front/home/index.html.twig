{% extends 'base.html.twig' %}

{% block title %}Walid BELBECHE | Consultant informatique, interlocuteur unique{% endblock %}

{% block content %}
{% set en = app.request.locale == 'en' %}

{# Premiere visite : trois portes pour orienter sans jargon. Montree une
   seule fois par navigateur (memorisee en localStorage). #}
<div id="wb-intro" class="wb-intro" hidden>
    <div class="wb-intro__card" data-tone="light" role="dialog" aria-modal="true" aria-label="{{ en ? 'Welcome' : 'Bienvenue' }}">
        <button type="button" id="wb-intro-close" class="wb-intro__close" aria-label="{{ en ? 'Close' : 'Fermer' }}">&times;</button>
        <span class="wb-eyebrow wb-eyebrow--ink">{{ en ? 'Welcome' : 'Bienvenue' }}</span>
        <h2 class="wb-h3" style="margin:.4rem 0 .5rem;">{{ en ? 'What brings you here?' : "Qu'est-ce qui vous amène ?" }}</h2>
        <p style="color: var(--wb-text-2); font-size:.92rem; margin-bottom:1.1rem;">
            {{ en ? 'One person, from first sketch to production. Pick your door, the rest is guided.'
                  : "Une seule personne, de l'idée à la mise en production. Choisissez votre porte, la suite est guidée." }}
        </p>
        <div class="wb-intro__doors">
            <a href="{{ url('front_project') }}" class="wb-intro__door">
                <strong>{{ en ? 'See real projects' : 'Voir du concret' }}</strong>
                <span>{{ en ? 'Delivered projects, sorted by your line of business.' : 'Des projets livrés, triés par secteur.' }}</span>
            </a>
            <a href="{{ url('front_devis_new') }}" class="wb-intro__door">
                <strong>{{ en ? 'Price my idea' : 'Chiffrer mon idée' }}</strong>
                <span>{{ en ? 'Two minutes, an answer within 48 working hours.' : 'Deux minutes, une réponse sous 48 h ouvrées.' }}</span>
            </a>
            <a href="{{ url('front_commencer') }}" class="wb-intro__door">
                <strong>{{ en ? 'Guide me' : 'Me laisser guider' }}</strong>
                <span>{{ en ? 'Not sure where to start? One minute tour.' : 'Pas sûr de par où commencer ? Visite en une minute.' }}</span>
            </a>
        </div>
        <button type="button" id="wb-intro-skip" class="wb-intro__skip">{{ en ? 'Just browse the site' : 'Je préfère juste visiter le site' }}</button>
    </div>
</div>
<script>
(function () {
    try {
        if (localStorage.getItem('wb_intro_vue')) { return; }
    } catch (e) { return; }
    var box = document.getElementById('wb-intro');
    if (!box) { return; }
    var fermer = function () {
        box.hidden = true;
        try { localStorage.setItem('wb_intro_vue', '1'); } catch (e) {}
    };
    box.hidden = false;
    document.getElementById('wb-intro-close').addEventListener('click', fermer);
    document.getElementById('wb-intro-skip').addEventListener('click', fermer);
    box.addEventListener('click', function (e) { if (e.target === box) { fermer(); } });
    box.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', fermer); });
})();
</script>

{# =====================================================================
   Accueil.
   Un principe a chaque section : ne jamais affirmer sans montrer.
   Les chiffres viennent du code reellement ecrit, les anecdotes de
   projets reellement livres.
   ===================================================================== #}

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="container" style="padding-top: 6.5rem;">
            <div class="wb-flash wb-flash--{{ type }}">{{ message|trans }}</div>
        </div>
    {% endfor %}
{% endfor %}

<section class="wb-hero wb-slant" data-tone="dark">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-7">
                <span class="wb-eyebrow">{{ 'home.eyebrow'|trans }}</span>

                <h1 class="wb-display">
                    {{ 'home.title_1'|trans }}<br>
                    {{ 'home.title_2'|trans }} <span class="wb-mark">{{ 'home.title_3'|trans }}</span><br>
                    {{ 'home.title_4'|trans }}
                </h1>

                <p class="wb-lead wb-lead--on-dark mb-4">
                    {{ 'home.lead'|trans }}
                </p>

                <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                    <a href="{{ url('front_devis_new') }}" class="wb-btn wb-btn--gold">
                        {{ 'home.cta_estimate'|trans }}
                    </a>
                    <a href="{{ url('front_commencer') }}" class="wb-btn wb-btn--ghost">
                        {{ app.request.locale == 'en' ? 'Where to start?' : 'Par où commencer ?' }}
                    </a>
                </div>

                <div class="wb-credential">
                    <span class="wb-credential__seal">RNCP</span>
                    <span class="wb-credential__txt">
                        <b>{{ 'home.rncp_title'|trans }}</b>
                        <span>{{ 'home.rncp_sub'|trans }}</span>
                    </span>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="wb-card wb-card--glass p-4" data-tone="dark">
                    <span class="wb-badge wb-badge--glass mb-3">{{ 'home.form_badge'|trans }}</span>
                    <h2 class="wb-h3 text-white mb-1">{{ 'home.form_title'|trans }}</h2>
                    <p class="small mb-4" style="color: var(--wb-on-dark-2);">
                        {{ 'home.form_lead'|trans }}
                    </p>

                    {{ form_start(form, {'attr': {'class': 'wb-form'}, 'method': 'POST'}) }}
                        {{ form_row(form.name, {'attr': {'class': 'form-control', 'placeholder': 'form_name_placeholder'|trans}}) }}
                        {{ form_row(form.phonePrefix, {'attr': {'class': 'form-select'}}) }}
                        {{ form_row(form.phone, {'attr': {'class': 'form-control', 'placeholder': 'form_phone_placeholder'|trans}}) }}
                        {{ form_row(form.email, {'attr': {'class': 'form-control', 'placeholder': 'form_email_placeholder'|trans}}) }}
                        <button type="submit" class="wb-btn wb-btn--gold w-100 mt-2">
                            {{ 'form_submit_button'|trans }}
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>

        </div>
    </div>
</section>

{# ------------------------------------------------------------ chiffres -- #}
<section class="wb-section--tight" style="background: var(--wb-paper);">
    <div class="container">
