{# ------------------------------------------------------- le vrai probleme -- #}
<section class="wb-section wb-section--paper" data-tone="light">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-5">
                <span class="wb-eyebrow wb-eyebrow--ink">{{ 'home.problem_eyebrow'|trans }}</span>
                <h2 class="wb-h2">{{ 'home.problem_title_1'|trans }}<br>{{ 'home.problem_title_2'|trans }}</h2>
                <p class="wb-lead">
                    {{ 'home.problem_p1'|trans }}
                </p>
                <p class="wb-lead">
                    {{ 'home.problem_p2'|trans }}
                </p>
            </div>

            <div class="col-lg-7">
                <div class="row g-3">
                    {% set piliers = [
                        {'n': '01', 'titre': "Je comprends votre métier avant d'écrire du code", 'texte': "Le cadrage vient toujours en premier. Cahier des charges, spécifications, user stories avec critères d'acceptation. Vous savez exactement ce que vous achetez, et moi ce que je livre."},
                        {'n': '02', 'titre': 'Je construis tout, du serveur à l\'écran', 'texte': "Base de données, API, back-office, site web, application mobile iOS et Android, mise en production. Aucun maillon confié à quelqu'un d'autre."},
                        {'n': '03', 'titre': 'Je reste joignable après la livraison', 'texte': "Un guichet d'assistance avec référence et suivi, un point hebdomadaire pour les idées, l'e-mail pour les décisions. Le cadre est écrit, il protège les deux parties."},
                        {'n': '04', 'titre': 'Je vous rends indépendant de moi', 'texte': "Code source, documentation et cession des droits au paiement final. Un autre développeur peut reprendre le projet demain. C'est voulu."}
                    ] %}
                    {% for pilier in piliers %}
                        <div class="col-md-6">
                            <div class="wb-card {{ loop.first ? 'wb-card--accent' : '' }}" data-tone="light">
                                <span class="wb-card__num">{{ pilier.n }}</span>
                                <h3 class="wb-h3">{{ pilier.titre }}</h3>
                                <p class="mb-0" style="color: var(--wb-text-2); font-size: .93rem;">{{ pilier.texte }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

