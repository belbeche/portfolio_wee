{# Administrable depuis le back office, section Equipe. Le premier membre
   enregistre est mis en avant : c'est l'interlocuteur unique promis partout
   ailleurs sur le site, les autres sont presentes comme le renfort. Aucune
   adresse e-mail n'est publiee, les robots les ramassent en quelques heures. #}
{% if members|length > 0 %}
<section class="wb-section wb-section--paper" data-tone="light" id="equipe">
    <div class="container">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <span class="wb-eyebrow wb-eyebrow--ink">{{ en ? 'The team' : "L'équipe" }}</span>
                <h2 class="wb-h2">{{ en ? 'One contact. A team behind him.' : 'Un interlocuteur. Une équipe derrière.' }}</h2>
                <p class="wb-lead mx-auto">
                    {{ en
                        ? 'You always talk to the same person. Behind that person, engineering students in placement work on the parts that can be shared, under review. Nothing reaches production without passing through me.'
                        : "Vous parlez toujours à la même personne. Derrière elle, des étudiants ingénieurs en immersion travaillent sur ce qui peut l'être, sous revue. Rien ne part en production sans passer par moi." }}
                </p>
            </div>
        </div>

        <div class="wb-team">
            {% for member in members %}
                <article class="wb-team__card {{ loop.first ? 'wb-team__card--lead' : '' }}" data-tone="light" style="--wb-delay: {{ loop.index0 * 70 }}ms;">
                    <div class="wb-team__photo">
                        {% if member.avatar %}
                            <img src="{{ asset('uploads/avatar/' ~ member.avatar) }}"
                                 alt="{{ member.firstname }} {{ member.lastname }}" loading="lazy" width="96" height="96">
                        {% else %}
                            <span class="wb-team__initiales" aria-hidden="true">{{ member.firstname|slice(0, 1)|upper }}{{ member.lastname|slice(0, 1)|upper }}</span>
                        {% endif %}
                    </div>
                    <h3 class="wb-team__nom">{{ member.firstname }} {{ member.lastname }}</h3>
                    <p class="wb-team__role">{{ member.function }}</p>
                    {% if member.description %}
                        <p class="wb-team__mot">{{ member.description|striptags|slice(0, 150) }}{{ member.description|striptags|length > 150 ? '...' : '' }}</p>
                    {% endif %}
                    {% if member.link %}
                        <a href="{{ member.link }}" class="wb-team__lien" target="_blank" rel="noopener noreferrer">
                            {{ en ? 'Profile' : 'Son profil' }}
                        </a>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

