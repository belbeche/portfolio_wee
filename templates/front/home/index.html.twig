            <div class="wb-stat"><div class="wb-stat__n">1</div><div class="wb-stat__l">{{ 'home.stat_contact'|trans }}<br>{{ 'home.stat_contact_2'|trans }}</div></div>
            <div class="wb-stat"><div class="wb-stat__n">100 %</div><div class="wb-stat__l">{{ 'home.stat_rights'|trans }}<br>{{ 'home.stat_rights_2'|trans }}</div></div>
        </div>
