{# ------------------------------------------------------------ competences -- #}
{% if skills is defined and skills|length > 0 %}
<section class="wb-section wb-section--ink" data-tone="dark">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-4">
                <span class="wb-eyebrow">{{ 'home.skills_eyebrow'|trans }}</span>
                <h2 class="wb-h2">{{ 'home.skills_title_1'|trans }}<br>{{ 'home.skills_title_2'|trans }}</h2>
                <p class="wb-lead wb-lead--on-dark">
                    {{ 'home.skills_lead'|trans }}
                </p>
                <a href="{{ url('front_methode') }}" class="wb-btn wb-btn--ghost mt-2">{{ 'home.skills_cta'|trans }}</a>

                <div class="wb-scale mt-4">
                    <p class="wb-scale__note">
                        {{ 'home.skills_note'|trans }}
                    </p>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="row g-4">
                    {% for group, list in skills %}
                        <div class="col-md-6">
                            <h3 class="wb-eyebrow" style="color: var(--wb-blue-soft);">{{ list|first.groupLabel }}</h3>
                            {% for skill in list %}
                                <div class="wb-skill {{ skill.highlighted ? 'wb-skill--gold' : '' }}"
                                     title="{{ skill.levelHint }}">
                                    <div class="wb-skill__head">
                                        <span class="wb-skill__name" style="color: #fff;">{{ skill.name }}</span>
                                        <span class="wb-skill__years">{% if skill.yearsOfExperience %}{{ skill.yearsOfExperience }} ans · {% endif %}{{ skill.levelLabel }}</span>
                                    </div>
                                    <div class="wb-skill__track" style="background: rgba(255,255,255,.12);"
                                         role="img" aria-label="{{ skill.levelLabel }}. {{ skill.levelHint }}">
                                        <div class="wb-skill__fill" style="width: {{ skill.levelPercent }}%;"></div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}

{# -------------------------------------------------------------- avis ------- #}
{% if reviews is defined and reviews|length > 0 %}
<section class="wb-section" data-tone="light">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <span class="wb-eyebrow wb-eyebrow--ink">{{ en is defined and en ? 'Reviews' : 'Avis' }}</span>
                <h2 class="wb-h2 mb-0">{{ en is defined and en ? 'They worked with me' : 'Ils ont travaillé avec moi' }}</h2>
            </div>
            <a href="{{ url('front_review') }}" class="wb-btn wb-btn--ghost-ink wb-btn--sm">
                {{ en is defined and en ? 'All reviews, and leave yours' : 'Tous les avis, et laisser le vôtre' }}
            </a>
        </div>
        <div class="row g-4">
            {% for review in reviews %}
                <div class="col-md-4 d-flex">
                    <article class="wb-review w-100" data-tone="light">
                        <div class="wb-review__stars" aria-label="{{ review.rating }}/5">
                            {% for i in 1..5 %}<span class="{{ i <= review.rating ? 'is-on' : '' }}">★</span>{% endfor %}
                        </div>
                        <p class="wb-review__text">{{ review.content|slice(0, 220) }}{{ review.content|length > 220 ? '…' : '' }}</p>
                        <p class="wb-review__author">{{ review.authorName }}{% if review.company %}, {{ review.company }}{% endif %}</p>
                    </article>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ---------------------------------------------- parcours par secteur ------- #}
{% set en = en is defined ? en : app.request.locale == 'en' %}
<section class="wb-section" data-tone="light">
    <div class="container">
        <div class="text-center mb-5">
            <span class="wb-eyebrow wb-eyebrow--ink">{{ en ? 'Where do you come from?' : "Vous venez d'où ?" }}</span>
            <h2 class="wb-h2">{{ en ? 'Tell me your world, I show you the way' : 'Dites-moi votre univers, je vous montre le chemin' }}</h2>
            <p class="wb-lead mx-auto" style="max-width: 640px;">
                {{ en ? 'You do not need to know what an API is. Pick the situation that looks like yours: I show you what I built for people like you, and where to start.'
                      : "Pas besoin de savoir ce qu'est une API. Choisissez la situation qui vous ressemble : je vous montre ce que j'ai construit pour des gens comme vous, et par où commencer." }}
            </p>
        </div>

        {% set secteurs = en ? [
            {'ico': '🏛', 't': "Association or local authority", 'd': "A service for your members or citizens, plus the written file your grant applications need.", 'q': 'Association'},
            {'ico': '🏪', 't': "Shop or local business", 'd': "Be found, take bookings or orders, stop losing evenings on paperwork.", 'q': 'Commerce'},
            {'ico': '🏢', 't': "Company with an internal tool", 'd': "The Excel that runs everything becomes a real application your team can rely on.", 'q': 'Entreprise'},
            {'ico': '🚀', 't': "Project owner with an idea", 'd': "From the idea to an application people can install, with a budget you approve step by step.", 'q': 'Startup'}
        ] : [
            {'ico': '🏛', 't': "Association ou collectivité", 'd': "Un service pour vos adhérents ou administrés, plus le dossier écrit qu'exigent vos demandes de subvention.", 'q': 'Association'},
            {'ico': '🏪', 't': "Commerce ou artisan", 'd': "Être trouvé, prendre des réservations ou des commandes, arrêter de perdre vos soirées en paperasse.", 'q': 'Commerce'},
            {'ico': '🏢', 't': "Entreprise avec un outil interne", 'd': "Le fichier Excel qui fait tourner la boîte devient une vraie application sur laquelle l'équipe peut compter.", 'q': 'Entreprise'},
            {'ico': '🚀', 't': "Porteur de projet avec une idée", 'd': "De l'idée à une application qu'on installe, avec un budget que vous validez étape par étape.", 'q': 'Startup'}
        ] %}

        <div class="row g-4">
            {% for sect in secteurs %}
                <div class="col-md-6 col-lg-3 d-flex">
                    <a href="{{ url('front_project') }}?secteur={{ sect.q|url_encode }}" class="wb-sector w-100">
                        <span class="wb-sector__ico" aria-hidden="true">{{ sect.ico }}</span>
                        <span class="wb-sector__title">{{ sect.t }}</span>
                        <span class="wb-sector__desc">{{ sect.d }}</span>
                        <span class="wb-sector__go">{{ en ? 'See what I built' : 'Voir ce que j\'ai construit' }} →</span>
                    </a>
                </div>
            {% endfor %}
        </div>

        <p class="text-center mt-4 mb-0" style="color: var(--wb-text-2);">
            {{ en ? 'None of these fits?' : 'Aucune ne vous ressemble ?' }}
            <a href="{{ url('front_devis_new') }}">{{ en ? 'Describe your need in your own words' : 'Décrivez votre besoin avec vos mots' }}</a>,
            {{ en ? 'I answer within 48 working hours.' : 'je réponds sous 48 heures ouvrées.' }}
        </p>
    </div>
</section>

{# ---------------------------------------------------------- realisations -- #}
<section class="wb-section wb-section--paper" data-tone="light">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-5">
            <div>
                <span class="wb-eyebrow wb-eyebrow--ink">{{ 'home.work_eyebrow'|trans }}</span>
                <h2 class="wb-h2 mb-0">{{ en ? 'Delivered projects, in production' : 'Des projets livrés, en production' }}</h2>
            </div>
            <a href="{{ url('front_project') }}" class="wb-btn wb-btn--outline">{{ 'home.work_all'|trans }} ({{ projects|length }})</a>
        </div>

        <div class="row g-4">
            {% for project in projects|slice(0, 6) %}
                <div class="col-md-6 col-lg-4">
                    <a href="{{ url('front_project_show', {id: project.id}) }}" class="wb-work">
                        {% set cover = project.images|first %}
                        {% if cover %}
                            <img class="wb-work__img" src="{{ asset('image_project/' ~ cover.name) }}" alt="" loading="lazy">
                        {% endif %}
                        <span class="wb-work__veil"></span>
                        <span class="wb-work__body">
                            {% if project.sector %}
                                <span class="wb-badge wb-badge--gold align-self-start">{{ project.sector }}</span>
                            {% endif %}
                            <span class="wb-work__title">{{ project.title }}</span>
                            <span class="wb-work__desc">
                                {{ (project.result ?: project.description)|striptags|slice(0, 130) }}{{ (project.result ?: project.description)|striptags|length > 130 ? '…' : '' }}
                            </span>
                        </span>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

