{% extends 'base.html.twig' %}

{% block title %}Devis en ligne
{% endblock %}

{% block content %}

	<script src="https://cdn.jsdelivr.net/npm/simple-parallax-js@5.6.1/dist/simpleParallax.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


	<script>
		var image = document.getElementsByClassName('thumbnail');
		new simpleParallax(image, {
			maxTransition: 60
		});
	</script>

	<section class="wb-hero wb-slant" data-tone="dark">
		<div class="container" style="padding-top: 7rem; padding-bottom: 6rem;">
			<div class="row g-5 align-items-center">
				<div class="col-lg-7">
					<span class="wb-eyebrow">{{ 'quote.eyebrow'|trans }}</span>
					<h1 class="wb-display">
						{{ 'quote.title_1'|trans }}<br><span class="wb-mark">{{ 'quote.title_2'|trans }}</span>.
					</h1>
					<p class="wb-lead wb-lead--on-dark mb-4">
						{{ 'quote.lead'|trans }}
					</p>
					<div class="d-flex flex-wrap gap-3">
						<span class="wb-badge wb-badge--glass">{{ 'quote.badge1'|trans }}</span>
						<span class="wb-badge wb-badge--glass">{{ 'quote.badge2'|trans }}</span>
						<span class="wb-badge wb-badge--glass">{{ 'quote.badge3'|trans }}</span>
					</div>
				</div>
				<div class="col-lg-5">
					<div class="wb-card wb-card--glass p-4" data-tone="dark">
						<h2 class="wb-h3 text-white">{{ 'quote.after_title'|trans }}</h2>
						<ol class="mb-0 ps-3" style="color: var(--wb-on-dark-2); font-size: .93rem;">
							<li class="mb-2">Je lis votre demande le jour même.</li>
							<li class="mb-2">Je vous écris si un point manque, plutôt que de chiffrer au hasard.</li>
							<li class="mb-2">Vous recevez un devis détaillé en PDF, valable un mois.</li>
							<li class="mb-0">Vous suivez l'avancement depuis votre <a href="{{ path('front_assistance') }}" class="text-warning">espace assistance</a>.</li>
						</ol>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="wb-section--tight" style="background: var(--wb-paper);">
		<div class="container">
			<div class="row g-4">
				<div class="col-md-4">
					<div class="wb-card wb-card--accent h-100" data-tone="light">
						<h3 class="wb-h3">{{ 'quote.card1_title'|trans }}</h3>
						<p class="mb-0" style="color: var(--wb-text-2); font-size: .93rem;">
							{{ 'quote.card1_p'|trans }}
						</p>
					</div>
				</div>
				<div class="col-md-4">
					<div class="wb-card h-100" data-tone="light">
						<h3 class="wb-h3">{{ 'quote.card2_title'|trans }}</h3>
						<p class="mb-0" style="color: var(--wb-text-2); font-size: .93rem;">
							{{ 'quote.card2_p'|trans }}
						</p>
					</div>
				</div>
				<div class="col-md-4">
					<div class="wb-card h-100" data-tone="light">
						<h3 class="wb-h3">{{ 'quote.card3_title'|trans }}</h3>
						<p class="mb-0" style="color: var(--wb-text-2); font-size: .93rem;">
							{{ 'quote.card3_p'|trans }}
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="container wb-section--tight text-center">
		<!-- Bouton pour ouvrir la modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#combinedModal">
          Voir les détails sur les types de sites et de design
        </button>

        <!-- La Modal -->
        <div class="modal fade" id="combinedModal" tabindex="-1" aria-labelledby="combinedModalLabel" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <!-- En-tête de la modal -->
              <div class="modal-header">
                <h5 class="modal-title" id="combinedModalLabel">Explications sur les Types de Sites Web et les Choix de Design</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
              </div>

              <!-- Contenu de la modal -->
              <div class="modal-body">
                <!-- Explications pour les Types de Sites Web -->
                <h5>Types de Sites Web:</h5>
                <p><strong>Site vitrine:</strong> Idéal pour les entreprises qui veulent présenter leurs produits ou services, mais sans vendre en ligne.</p>
                <p><strong>E-Commerce:</strong> Pour les entreprises qui veulent vendre des produits ou des services en ligne.</p>
                <p><strong>Blog professionnel:</strong> Pour les entreprises ou les individus qui souhaitent partager des sujets, des actualités et des informations pertinentes.</p>
                <p><strong>Portfolio:</strong> Idéal pour les artistes, photographes, designers, etc., qui souhaitent montrer leur travail.</p>
                <p><strong>Forum communautaire:</strong> Pour créer une communauté en ligne centrée autour d'un sujet ou d'un intérêt commun.</p>
                <p><strong>Site d'information ou magazine en ligne:</strong> Pour les entreprises de médias ou les individus qui partagent des actualités et des sujets fréquemment.</p>
                <p><strong>Application Web et Mobile (Cross-plateforme):</strong> Des applications qui fonctionnent à la fois sur le web et les mobiles.</p>
                <p><strong>Système de Gestion de Contenu (CMS):</strong> Pour les entreprises qui ont besoin d'un système robuste pour gérer beaucoup de contenu.</p>
                <p><strong>Intranet d'entreprise:</strong> Pour les besoins internes de l'entreprise, comme la gestion des ressources humaines, des projets, etc.</p>
                <p><strong>Application spécifique:</strong> Pour des besoins très spécifiques qui ne rentrent pas dans les catégories précédentes. Le client peut décrire ses besoins en détail.</p>

                <h5>Explications pour les choix de design:</h5>
                <h6>Design standard :</h6>
                <p>Un design simple et efficace qui suit les meilleures pratiques du secteur.</p>

                <h6>Avec vos propres maquettes :</h6>
                <p>Si vous avez déjà conçu des maquettes ou des wireframes, cette option est pour vous.</p>

                <h6>Design avancé :</h6>
                <p>Un design entièrement personnalisé avec des fonctionnalités et des interactions complexes.</p>

                <h6>Design orienté vers le mobile :</h6>
                <p>Un design qui priorise l'expérience utilisateur sur les appareils mobiles.</p>

                <h6>Design animé ou interactif :</h6>
                <p>Inclut des animations et des interactions utilisateur pour un site plus dynamique.</p>

                <h6>Thème sombre :</h6>
                <p>Utilisation d'un thème de couleurs sombres pour réduire la fatigue oculaire et économiser de l'énergie sur les écrans OLED.</p>

                <h6>Thème clair :</h6>
                <p>Utilisation d'un thème de couleurs clairs pour améliorer la lisibilité et l'attrait visuel.</p>

                <h6>Design axé sur l’accessibilité :</h6>
                <p>Un design qui est optimisé pour l'accessibilité, conformément aux directives WCAG.</p>

                <h6>Design minimaliste :</h6>
                <p>Un design simple avec peu de couleurs et d'éléments, axé sur la facilité d'utilisation.</p>

                <h6>Branding complet inclus :</h6>
                <p>Inclut la création d'un logo, la sélection de couleurs de marque et d'autres éléments de branding.</p>

                <h6>Personnalisation avancée :</h6>
                <p>Offre une grande flexibilité dans la personnalisation du design, y compris des options avancées comme des micro-interactions, etc.</p>
              </div>

              <!-- Pied de page de la modal -->
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
              </div>
            </div>
          </div>
        </div>


	</section>

	<!-- Début du formulaire -->
	<section class="wb-section" data-tone="light" id="formulaire">
		<div class="container" style="max-width: 900px;">

			<div class="wb-card" data-tone="light" style="padding: 2rem 2rem 2.2rem;">

				{# Reperes d'avancement : un formulaire long sans repere donne
				   l'impression de ne jamais finir. #}
				<div class="wb-steps">
					<span class="wb-steps__item is-current"></span>
					<span class="wb-steps__item"></span>
					<span class="wb-steps__item"></span>
				</div>

				<h2 class="wb-h2" style="font-size: 1.5rem;">{{ 'quote.form_title'|trans }}</h2>
				<p class="wb-lead" style="font-size: 1rem; margin-bottom: 2rem;">
					{{ 'quote.form_lead'|trans }}
				</p>

				<div class="wb-form">
					{{ form_start(formDevis, {'attr': {'novalidate': 'novalidate'}}) }}

						{# ------------------------------------------------ 1. contact -- #}
						<fieldset style="border: 0; padding: 0; margin: 0 0 2rem;">
							<legend class="wb-eyebrow wb-eyebrow--ink" style="float: none; width: auto; font-size: .72rem;">
								{{ 'quote.step1'|trans }}
							</legend>

							{% if not app.user %}
								{{ form_row(formDevis.email, {
									'label': 'quote.email_label'|trans,
									'attr': {'class': 'form-control', 'placeholder': 'vous@votre-entreprise.fr', 'autocomplete': 'email'}
								}) }}
								<div class="form-text" style="margin-top: -.5rem;">
									{{ 'quote.email_help'|trans }}
								</div>
							{% else %}
								{{ form_row(formDevis.email, {'row_attr': {'class': 'd-none'}}) }}
								<p style="font-size: .9rem; color: var(--wb-text-2); margin: 0;">
									{{ 'quote.sent_to'|trans }} <strong>{{ app.user.email }}</strong>.
								</p>
							{% endif %}
							{{ form_errors(formDevis.email) }}
						</fieldset>

						{# --------------------------------------------------- 2. type -- #}
						<fieldset style="border: 0; padding: 0; margin: 0 0 2rem;">
							<legend class="wb-eyebrow wb-eyebrow--ink" style="float: none; width: auto; font-size: .72rem;">
								{{ 'quote.step2'|trans }}
							</legend>

							{{ form_row(formDevis.type_de_site_web, {
								'label': 'quote.type_label'|trans,
								'attr': {'class': 'form-select'}
							}) }}
							{{ form_errors(formDevis.type_de_site_web) }}

							<button type="button" class="wb-btn wb-btn--outline"
							        style="padding: .4rem .85rem; font-size: .82rem; margin-top: .5rem;"
							        data-bs-toggle="modal" data-bs-target="#combinedModal">
								{{ 'quote.type_help'|trans }}
							</button>
						</fieldset>

						{# ------------------------------------------------- 3. design -- #}
						<fieldset style="border: 0; padding: 0; margin: 0 0 2rem;">
							<legend class="wb-eyebrow wb-eyebrow--ink" style="float: none; width: auto; font-size: .72rem;">
								{{ 'quote.step3'|trans }}
							</legend>

							<p style="font-size: .9rem; color: var(--wb-text-2); margin-bottom: 1rem;">
								{{ 'quote.design_help'|trans }}
							</p>

							<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
								{% for option in formDevis.attentes_design_web %}
									<div class="col">
										<label class="wb-choice h-100 d-flex align-items-start gap-2">
											{{ form_widget(option, {'label': false, 'attr': {'class': 'form-check-input mt-1 flex-shrink-0'}}) }}
											<span style="font-size: .9rem; line-height: 1.4;">{{ option.vars.label }}</span>
										</label>
									</div>
								{% endfor %}
							</div>
							{{ form_errors(formDevis.attentes_design_web) }}
						</fieldset>

						{# --------------------------------------------- 4. description -- #}
						<fieldset style="border: 0; padding: 0; margin: 0 0 2rem;">
							<legend class="wb-eyebrow wb-eyebrow--ink" style="float: none; width: auto; font-size: .72rem;">
								{{ 'quote.step4'|trans }}
							</legend>

							{{ form_row(formDevis.description_projet, {
								'label': 'quote.desc_label'|trans,
								'attr': {
									'class': 'form-control',
									'rows': 6,
									'placeholder': 'quote.desc_ph'|trans
								}
							}) }}
							{{ form_errors(formDevis.description_projet) }}

							<div class="form-text">
								{{ 'quote.desc_help'|trans }}
							</div>
						</fieldset>

						{# ------------------------------------------------- validation -- #}
						<div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 pt-3"
						     style="border-top: 1px solid var(--wb-line);">
							<button type="submit" class="wb-btn wb-btn--gold">
								{{ 'quote.submit'|trans }}
							</button>
							<span style="font-size: .84rem; color: var(--wb-text-3);">
								{{ 'quote.submit_note'|trans }}
							</span>
						</div>

					{{ form_end(formDevis) }}
				</div>

			</div>

			<p class="text-center" style="font-size: .84rem; color: var(--wb-text-3); margin-top: 1.5rem;">
				{{ 'quote.prefer_talk'|trans }}
				<a href="{{ url('front_contact') }}">{{ 'quote.write_me'|trans }}</a> ou appelez le
				<a href="tel:0661287786">06 61 28 77 86</a>.
			</p>

		</div>
	</section>

{% endblock %}
