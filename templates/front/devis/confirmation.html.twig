{% extends 'base.html.twig' %}

{% block title %}{{ app.request.locale == 'en' ? 'Request received' : 'Demande bien reçue' }}{% endblock %}

{% block content %}
{% set en = app.request.locale == 'en' %}

<section class="wb-section wb-section--paper" data-tone="light" style="min-height: 60vh;">
    <div class="container" style="max-width: 720px; padding-top: 4rem;">
        <div class="wb-card text-center" data-tone="light" style="padding: 2.4rem 2rem;">
            <span class="wb-eyebrow wb-eyebrow--ink">{{ en ? 'Request received' : 'Demande reçue' }}</span>
            <h1 class="wb-h2" style="margin: .5rem 0 .8rem;">
                {{ en ? 'Your request is in good hands' : 'Votre demande est entre de bonnes mains' }}
            </h1>
            <p style="color: var(--wb-text-2); max-width: 520px; margin: 0 auto 1rem;">
                {{ en ? 'A confirmation e-mail is on its way (check the spam folder if needed). I read every request personally and answer with a detailed, line-by-line quote within 48 working hours.'
                      : "Un e-mail de confirmation vous a été envoyé (pensez aux indésirables si vous ne le voyez pas). Je lis chaque demande personnellement et je réponds avec un chiffrage détaillé, ligne par ligne, sous 48 heures ouvrées." }}
            </p>
            <p style="color: var(--wb-text-3); font-size: .85rem; margin: 0 0 1.4rem;">
                {{ en ? 'No sales follow-ups: the quote, and nothing else.' : 'Aucune relance commerciale : le devis, et c\'est tout.' }}
            </p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                {% if app.user %}
                    <a href="{{ url('front_assistance') }}" class="wb-btn wb-btn--ink">{{ en ? 'Open my client area' : 'Accéder à mon espace' }}</a>
                {% else %}
                    <a href="{{ url('app_login') }}" class="wb-btn wb-btn--ink">{{ en ? 'Sign in' : 'Me connecter' }}</a>
                {% endif %}
                <a href="{{ url('front_project') }}" class="wb-btn wb-btn--outline">{{ en ? 'Browse my projects meanwhile' : 'Voir mes réalisations en attendant' }}</a>
            </div>
        </div>
    </div>
</section>

{% endblock %}
