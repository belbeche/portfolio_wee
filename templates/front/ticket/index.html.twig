{% extends 'base.html.twig' %}

{% block title %}Mon assistance - Walid Belbeche{% endblock %}

{% block content %}

<section class="wb-hero" data-tone="dark">
    <div class="container" style="padding-top: 1rem; padding-bottom: 3.5rem;">
        <span class="wb-eyebrow">{{ app.request.locale == 'en' ? 'Client area' : 'Espace client' }}</span>
        <h1 class="wb-display" style="font-size: clamp(1.9rem, 4vw, 2.8rem);">{{ app.request.locale == 'en' ? 'My assistance' : 'Mon assistance' }}</h1>
        <p class="wb-lead wb-lead--on-dark" style="max-width: 640px;">
            Chaque demande ouvre un fil daté qui reste consultable. Vous n'avez pas à
            retrouver un e-mail six mois plus tard pour savoir ce qui a été décidé.
        </p>
        <div class="d-flex flex-wrap gap-3 mt-4">
            <a href="{{ path('send_message') }}" class="wb-btn wb-btn--gold">Ouvrir une demande</a>
            <a href="{{ path('front_espace_client') }}" class="wb-btn wb-btn--ghost">Retour au tableau de bord</a>
        </div>
    </div>
</section>

<section class="wb-section wb-section--paper" data-tone="light">
    <div class="container">

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% if tickets|length > 0 %}

            {% set ouverts = tickets|filter(t => t.status != 'termine')|length %}
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                <div>
                    <h2 class="wb-h2 mb-1">{{ tickets|length }} demande{{ tickets|length > 1 ? 's' : '' }}</h2>
                    <p class="mb-0" style="color: var(--wb-text-2);">
                        {% if ouverts > 0 %}
                            {{ ouverts }} en cours de traitement.
                        {% else %}
                            Toutes vos demandes sont clôturées.
                        {% endif %}
                        Réponse sous 4 heures ouvrées.
                    </p>
                </div>
            </div>

            <div class="wb-tickets">
                {% for message in tickets %}
                    {% set libelles = {
                        'en_cours':   'Réponse du support',
                        'en_attente': "En attente de ma réponse",
                        'termine':    'Clôturé',
                        'livre':      'Service livré'
                    } %}
                    {% set couleurs = {
                        'en_cours': 'wb-tag--blue', 'en_attente': 'wb-tag--gold',
                        'termine':  'wb-tag--green', 'livre': 'wb-tag--green'
                    } %}
                    {% set etatLabel = libelles[message.status] is defined ? libelles[message.status] : message.status|replace({'_': ' '})|capitalize %}
                    {% set etatClass = couleurs[message.status] is defined ? couleurs[message.status] : 'wb-tag--grey' %}

                    <article class="wb-ticket {{ message.status == 'termine' ? 'wb-ticket--done' : '' }}">
                        <div class="wb-ticket__top">
                            <span class="wb-ticket__ref">Demande n° {{ message.id }}</span>
                            <span class="wb-tag {{ etatClass }}">{{ etatLabel }}</span>
                        </div>

                        <p class="wb-ticket__extract">
                            {{ message.content|length > 180 ? message.content|slice(0, 180) ~ '…' : message.content }}
                        </p>

                        <dl class="wb-ticket__meta">
                            <div><dt>Ouverte le</dt><dd>{{ message.createdAt|date('d/m/Y à H\\hi') }}</dd></div>
                            {% if message.devis is not null %}
                                <div><dt>Projet</dt><dd>{{ message.devis.typeDeSiteWeb }}</dd></div>
                                {% if message.devis.attentesDesignWeb|length %}
                                    <div><dt>Attentes</dt><dd>{% for design in message.devis.attentesDesignWeb %}{{ design.label }}{{ not loop.last ? ', ' : '' }}{% endfor %}</dd></div>
                                {% endif %}
                            {% endif %}
                        </dl>

                        <div class="wb-ticket__actions">
                            <a href="{{ path('front_ticket_details', {'id': message.id}) }}" class="wb-btn wb-btn--ink wb-btn--sm">Voir le fil</a>
                            {% if message.status != 'termine' %}
                                <a href="{{ path('respond_to_ticket', {'id': message.id}) }}" class="wb-btn wb-btn--ghost-ink wb-btn--sm">Répondre</a>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>

        {% else %}

            <div class="wb-card wb-card--accent" data-tone="light" style="max-width: 680px;">
                <h2 class="wb-h3">Aucune demande ouverte</h2>
                <p style="color: var(--wb-text-2);">
                    C'est plutôt bon signe. Le jour où quelque chose coince, ouvrez une demande
                    ici plutôt que de m'écrire un e-mail : le fil garde la trace de ce qui a été
                    dit, de ce qui a été corrigé, et de quand.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-3">
                    <a href="{{ path('send_message') }}" class="wb-btn wb-btn--ink">Ouvrir une demande</a>
                    <a href="{{ url('front_devis_new') }}" class="wb-btn wb-btn--ghost-ink">Demander un devis</a>
                </div>
            </div>

        {% endif %}

    </div>
</section>

{% endblock %}
