{% extends 'emails/_layout.html.twig' %}

{% block email_title %}Votre demande d'assistance est ouverte{% endblock %}

{% block email_preview %}Votre demande est ouverte et suivie.{% endblock %}
{% block email_kicker %}Assistance{% endblock %}

{% block email_hero %}
    <p style="margin:0 0 10px;font-family:Arial,Helvetica,sans-serif;font-size:25px;line-height:1.22;font-weight:bold;color:#ffffff;">
        Votre demande<br><span style="color:#f5b301;">est prise en charge</span>
    </p>
    <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#a9bdd8;">
        Elle est enregistrée et suivie. Vous serez prévenu à chaque avancée.
    </p>
{% endblock %}

{% block email_body %}
    <p style="margin:0 0 14px;">Bonjour,</p>
    <p style="margin:0 0 14px;">
        Votre demande d'assistance est bien enregistrée. Je vous réponds
        <strong style="color:#0a1628;">sous 4 heures ouvrées</strong>, directement
        dans le fil de la demande sur votre espace client.
    </p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:14px 0;border:1px solid #e4e7ec;border-radius:8px;background-color:#f8fafc;">
        <tr><td style="padding:7px 14px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#6b7280;white-space:nowrap;">Projet concerné</td><td style="padding:7px 14px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#0a1628;">{{ subject }}</td></tr>
        <tr><td style="padding:7px 14px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#6b7280;white-space:nowrap;">Votre adresse</td><td style="padding:7px 14px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#0a1628;">{{ email_address }}</td></tr>
    </table>

    {% if message %}
    <p style="margin:14px 0 6px;font-size:13px;color:#6b7280;">Votre message :</p>
    <p style="margin:0 0 14px;padding:12px 14px;background-color:#f8fafc;border-left:3px solid #f5b301;font-size:13px;color:#333c4d;">
        {{ message }}
    </p>
    {% endif %}

    <p style="margin:0;font-size:13px;color:#6b7280;">
        Tout l'historique reste consultable dans votre espace, rubrique Assistance.
    </p>
{% endblock %}
