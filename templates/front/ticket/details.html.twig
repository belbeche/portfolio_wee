{% extends 'base.html.twig' %}

{% block title %}{{ app.request.locale == 'en' ? 'Request thread' : 'Fil de la demande' }} n° {{ ticket.id }}{% endblock %}

{% block content %}
{% set en = app.request.locale == 'en' %}

<section class="wb-section wb-section--paper" data-tone="light" style="padding-top: 1rem;">
    <div class="container" style="max-width: 880px;">

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <span class="wb-eyebrow wb-eyebrow--ink">{{ en ? 'Client area' : 'Espace client' }}</span>
                <h1 class="wb-h2 mb-1">{{ en ? 'The request thread' : 'Le fil de la demande' }}</h1>
                <p class="mb-0" style="color: var(--wb-text-2);">
                    {{ en ? 'The whole exchange, dated, in one place. Answer within 4 working hours.'
                          : "Tout l'échange, daté, au même endroit. La réponse arrive sous 4 heures ouvrées." }}
                </p>
            </div>
            <a href="{{ path('front_show_ticket', {'id': ticket.devis.id}) }}" class="wb-btn wb-btn--ghost-ink wb-btn--sm">
                {{ en ? 'Back to my requests' : 'Retour à mes demandes' }}
            </a>
        </div>

        {% set etat = {
            'en_cours':   {'l': en ? 'Support replied' : 'Réponse du support', 'c': 'wb-tag--blue'},
            'en_attente': {'l': en ? 'Waiting for my reply' : 'En attente de ma réponse', 'c': 'wb-tag--gold'},
            'termine':    {'l': en ? 'Closed' : 'Clôturé', 'c': 'wb-tag--green'},
            'livre':      {'l': en ? 'Delivered' : 'Service livré', 'c': 'wb-tag--green'}
        }[ticket.status]|default({'l': ticket.status|capitalize, 'c': 'wb-tag--grey'}) %}

        <div class="wb-card mb-4" data-tone="light">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 class="wb-h3 mb-0">{{ en ? 'Request' : 'Demande' }} n° {{ (ticket.id ~ '')|slice(0, 8) }}</h2>
                <span class="wb-tag {{ etat.c }}">{{ etat.l }}</span>
            </div>
            <dl class="wb-ticket__meta mb-0">
                <div><dt>{{ en ? 'Opened on' : 'Ouverte le' }}</dt><dd>{{ ticket.createdAt|date('d/m/Y à H\\hi') }}</dd></div>
                {% if ticket.devis is not null %}
                    <div><dt>{{ en ? 'Project' : 'Projet' }}</dt><dd>{{ ticket.devis.typeDeSiteWeb }}</dd></div>
                    {% if ticket.devis.attentesDesignWeb|length %}
                        <div><dt>{{ en ? 'Design' : 'Attentes' }}</dt><dd>{% for design in ticket.devis.attentesDesignWeb %}{{ design.label }}{{ not loop.last ? ', ' : '' }}{% endfor %}</dd></div>
                    {% endif %}
                {% endif %}
                <div><dt>{{ en ? 'Subject' : 'Objet' }}</dt><dd>{{ ticket.content }}</dd></div>
            </dl>
        </div>

        <h2 class="wb-h3 mb-3">{{ en ? 'Messages' : 'Messages' }}</h2>

        {% if ticket.messages|length > 0 %}
            <div class="wb-thread mb-4">
                {% for message in ticket.messages %}
                    <article class="wb-thread__msg {{ message.sender.email == app.user.email ? 'wb-thread__msg--me' : 'wb-thread__msg--support' }}">
                        <div class="wb-thread__head">
                            <img src="{{ asset('uploads/avatar/' ~ (message.sender.avatar ?: 'support0.svg')) }}"
                                 alt="" width="34" height="34" class="rounded-circle" style="object-fit: cover;">
                            <strong>{{ message.sender.username }}</strong>
                            <time class="wb-thread__date">{{ message.createdAt|date('d/m/Y H:i') }}</time>
                        </div>
                        <p class="mb-0">{{ message.content|nl2br }}</p>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="wb-card mb-4" data-tone="light">
                <p class="mb-0" style="color: var(--wb-text-2);">
                    {{ en ? 'No message yet on this request.' : 'Aucun message pour cette demande pour le moment.' }}
                </p>
            </div>
        {% endif %}

        {% if ticket.status != 'termine' %}
            <a href="{{ path('respond_to_ticket', {'id': ticket.id}) }}" class="wb-btn wb-btn--ink">
                {{ en ? 'Reply' : 'Répondre' }}
            </a>
        {% endif %}

    </div>
</section>

{% endblock %}
