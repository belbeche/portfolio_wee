{% extends 'emails/_layout.html.twig' %}

{% block email_title %}Une réponse vous attend{% endblock %}

{% block email_body %}
    <p style="margin:0 0 14px;">Bonjour,</p>
    <p style="margin:0 0 14px;">
        Une réponse vient d'être apportée à votre demande d'assistance.
    </p>

    <p style="margin:14px 0 6px;font-size:13px;color:#6b7280;">La réponse :</p>
    <p style="margin:0 0 14px;padding:12px 14px;background-color:#f8fafc;border-left:3px solid #f5b301;font-size:13px;color:#333c4d;">
        {{ message }}
    </p>

    <p style="margin:0 0 14px;">
        Pour poursuivre l'échange, répondez depuis le fil de la demande dans votre
        espace client : c'est ce qui garde l'historique complet au même endroit.
    </p>
    <p style="margin:0;font-size:13px;color:#6b7280;">
        Si la réponse règle votre question, vous n'avez rien d'autre à faire.
    </p>
{% endblock %}
