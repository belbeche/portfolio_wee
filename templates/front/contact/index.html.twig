{% extends 'base.html.twig' %}

{% block title %}{{ 'contact_page_title'|trans }}{% endblock %}

{% block content %}
{% set en = app.request.locale == 'en' %}

<section class="wb-hero" data-tone="dark">
    <div class="container" style="padding-top: 7rem; padding-bottom: 3.5rem;">
        <span class="wb-eyebrow">Contact</span>
        <h1 class="wb-display" style="font-size: clamp(2rem, 4vw, 3rem);">
            {{ en ? 'One person answers you' : 'Une personne vous répond' }}
        </h1>
        <p class="wb-lead wb-lead--on-dark mb-0" style="max-width: 640px;">
            {{ en ? 'No sales department, no ticket queue for prospects. You write, I read, I answer within one working day.'
                  : "Pas de service commercial, pas de file d'attente. Vous écrivez, je lis, je réponds sous un jour ouvré." }}
        </p>
    </div>
</section>

<section class="wb-section wb-section--paper" data-tone="light">
    <div class="container">

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="wb-card h-100" data-tone="light">
                    <h2 class="wb-h3">{{ en ? 'Direct lines' : 'Les lignes directes' }}</h2>

                    <dl class="wb-ticket__meta mt-3 mb-4">
                        <div><dt>{{ en ? 'Phone' : 'Téléphone' }}</dt>
                             <dd><a href="tel:+33661287786">06 61 28 77 86</a></dd></div>
                        <div><dt>{{ en ? 'E-mail' : 'Courriel' }}</dt>
                             <dd><a href="mailto:contact@walidbelbeche.fr">contact@walidbelbeche.fr</a></dd></div>
                        <div><dt>{{ en ? 'Address' : 'Adresse' }}</dt>
                             <dd>{{ 'contact_address'|trans }}</dd></div>
                    </dl>

                    <p class="mb-3" style="color: var(--wb-text-2); font-size: .9rem;">
                        {{ en ? 'Prefer a scheduled call? Pick a slot, it is free and without commitment.'
                              : "Vous préférez un créneau posé ? Réservez un appel, c'est offert et sans engagement." }}
                    </p>
                    <a href="https://calendly.com/walid_belbeche/expertise-offerte" class="wb-btn wb-btn--outline w-100" rel="noopener">
                        {{ en ? 'Book a call' : 'Réserver un appel' }}
                    </a>

                    <hr style="border-color: var(--wb-line); margin: 1.4rem 0;">

                    <a class="wb-btn wb-btn--ghost-ink w-100" href="https://g.page/r/CSj9BKNjCGCBEAI/review" rel="noopener">
                        {{ en ? 'Leave a Google review' : 'Laisser un avis Google' }}
                    </a>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="wb-card" data-tone="light">
                    <h2 class="wb-h3 mb-1">{{ 'contact_form_title'|trans }}</h2>
                    <p class="mb-4" style="color: var(--wb-text-2); font-size: .93rem;">
                        {{ en ? 'A few lines are enough. If it looks like a project, I will come back with the right questions.'
                              : "Quelques lignes suffisent. Si ça ressemble à un projet, je reviens vers vous avec les bonnes questions." }}
                    </p>

                    {{ form_start(form, {'action': path('front_contact'), 'attr': {'id': 'contact_form'}}) }}
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_row(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'contact_form_first_name_placeholder'|trans }}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'contact_form_last_name_placeholder'|trans }}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.email, {'attr': {'class': 'form-control', 'placeholder': 'contact_form_email_placeholder'|trans }}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.phone, {'attr': {'class': 'form-control', 'placeholder': 'contact_form_phone_placeholder'|trans }}) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(form.service, {'attr': {'class': 'form-select'}}) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(form.content, {'attr': {'class': 'form-control', 'rows': 6, 'placeholder': 'contact_form_message_placeholder'|trans }}) }}
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="wb-btn wb-btn--gold">{{ 'contact_form_submit'|trans }}</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <div class="wb-card mt-4 p-0" data-tone="light" style="overflow: hidden;">
            <iframe src="https://www.google.com/maps?q=173+rue+de+Courcelles,+75017+Paris,+France&hl=fr&z=16&output=embed"
                    width="100%" height="360" style="border:0; display:block;" allowfullscreen=""
                    loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                    title="{{ 'contact_location_title'|trans }}"></iframe>
        </div>

    </div>
</section>

{% endblock %}
