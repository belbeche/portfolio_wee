{% extends 'base.html.twig' %}

{% block title %}{{ post.titleFor(app.request.locale) }} | Walid Belbeche{% endblock %}
{% block meta_description %}{{ post.contentFor(app.request.locale)|striptags|slice(0, 155)|trim }}{% endblock %}

{% block content %}
{% set en = app.request.locale == 'en' %}
{% set texte = post.contentFor(app.request.locale)|striptags %}
{% set minutes = max(1, (texte|split(' ')|length / 200)|round(0, 'ceil')) %}

<link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/themes/prism-tomorrow.min.css" rel="stylesheet">

{# ---------------------------------------------------------------- en-tete #}
<section class="wb-hero" data-tone="dark">
    <div class="container" style="padding-top: 1rem; padding-bottom: 3rem; max-width: 820px;">
        <nav class="wb-crumb" aria-label="{{ en ? 'You are here' : 'Vous êtes ici' }}">
            <a href="{{ path('blog_index') }}">{{ en ? 'Field notes' : 'Notes de terrain' }}</a>
            {% if post.category %}
                <span aria-hidden="true">/</span>
                <a href="{{ path('blog_category', { category: post.category.name }) }}">{{ post.category.name }}</a>
            {% endif %}
        </nav>

        <h1 class="wb-display" style="font-size: clamp(1.9rem, 3.8vw, 2.7rem); line-height: 1.15;">{{ post.titleFor(app.request.locale) }}</h1>

        <div class="wb-case-meta">
            <span>{{ post.createdAt|date('d/m/Y') }}</span>
            <span>{{ minutes }} min {{ en ? 'read' : 'de lecture' }}</span>
            <span>{{ en ? 'By Walid Belbeche' : 'Par Walid Belbeche' }}</span>
        </div>
    </div>
</section>

{# ----------------------------------------------------------------- article #}
<section class="wb-section wb-section--paper" data-tone="light">
    <div class="container" style="max-width: 820px;">

        {% if en and not post.hasEnglishVersion() %}
            <p class="wb-note-langue">
                This article is only available in French for now. Here it is in the original language.
            </p>
        {% endif %}

        <article class="wb-article" lang="{{ en and post.hasEnglishVersion() ? 'en' : 'fr' }}">
            {{ post.contentFor(app.request.locale)|raw }}

            {% for section in post.sections %}
                {% if section.type == 'content' %}
                    {{ section.content|raw }}

                {% elseif section.type == 'code' %}
                    <figure class="wb-code">
                        <figcaption>{{ section.language|default('code') }}</figcaption>
                        <pre><code class="language-{{ section.language|default('plaintext') }}">{{ section.content|e }}</code></pre>
                    </figure>

                {% elseif section.type == 'media' %}
                    {% if section.mediaType == 'image' %}
                        <figure class="wb-article__media">
                            <img src="{{ asset('uploads/' ~ section.mediaUrl) }}" alt="" loading="lazy">
                        </figure>
                    {% elseif section.mediaType == 'video' %}
                        <figure class="wb-article__media">
                            <video controls preload="metadata">
                                <source src="{{ asset('uploads/' ~ section.mediaUrl) }}" type="video/mp4">
                            </video>
                        </figure>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </article>

        {# ------------------------------------------------------- signature #}
        <div class="wb-author">
            <div class="wb-author__img">WB</div>
            <div>
                <strong>Walid Belbeche</strong>
                <p>{{ en ? 'Independent consultant. I design and build web and mobile applications, from the first question to going live.'
                         : "Consultant indépendant. Je conçois et développe des applications web et mobiles, de la première question à la mise en ligne." }}</p>
                <a href="{{ url('front_devis_new') }}" class="wb-btn wb-btn--ink wb-btn--sm">{{ en ? 'Talk about your project' : 'Parler de votre projet' }}</a>
            </div>
        </div>

        {# --------------------------------------------------- lire ensuite #}
        {% if suivants is defined and suivants|length %}
            <div class="mt-5">
                <h2 class="wb-h3 mb-4">{{ en ? 'Read next' : 'À lire ensuite' }}</h2>
                <div class="row g-4">
                    {% for autre in suivants %}
                        <div class="col-md-4 d-flex">
                            <article class="wb-note w-100">
                                <div class="wb-note__meta">
                                    {% if autre.category %}<span class="wb-note__cat">{{ autre.category.name }}</span>{% endif %}
                                    <span>{{ autre.createdAt|date('d/m/Y') }}</span>
                                </div>
                                <h3 class="wb-note__title">
                                    <a href="{{ path('blog_show', { slug: autre.slug }) }}">{{ autre.titleFor(app.request.locale) }}</a>
                                </h3>
                                <a href="{{ path('blog_show', { slug: autre.slug }) }}" class="wb-note__go">{{ en ? 'Read' : 'Lire' }} &rarr;</a>
                            </article>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/prism.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/components/prism-php.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/components/prism-javascript.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/components/prism-css.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/components/prism-bash.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/components/prism-json.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.28.0/components/prism-sql.min.js" defer></script>

{# Donnees structurees de l'article, pour l'affichage dans les resultats #}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ post.titleFor(app.request.locale)|json_encode|raw }},
    "datePublished": "{{ post.createdAt|date('c') }}",
    "dateModified": "{{ post.createdAt|date('c') }}",
    "description": {{ post.contentFor(app.request.locale)|striptags|slice(0, 155)|trim|json_encode|raw }},
    "image": "{{ app.request.schemeAndHttpHost ~ asset('medias/pwa/icon-512.png') }}",
    "author": { "@type": "Person", "name": "Walid Belbeche", "url": "https://walidbelbeche.fr" },
    "publisher": {
        "@type": "Organization",
        "name": "Walid Belbeche",
        "logo": { "@type": "ImageObject", "url": "{{ app.request.schemeAndHttpHost ~ asset('medias/pwa/icon-512.png') }}" }
    },
    "mainEntityOfPage": "{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}"
}
</script>

{% endblock %}
