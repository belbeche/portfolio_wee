{% extends 'base.html.twig' %}

{% block title %}Sujets de Support{% endblock %}

{% block content %}

<section class="wb-hero" data-tone="dark">
    <div class="container" style="padding-top: 7rem; padding-bottom: 3rem;">
        <span class="wb-eyebrow">{{ app.request.locale == 'en' ? 'Forum and support' : 'Forum et support' }}</span>
        <h1 class="wb-display" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">{{ app.request.locale == 'en' ? 'The forum' : 'Le forum' }}</h1>
        <p class="wb-lead wb-lead--on-dark mb-0" style="max-width:620px;">Les questions des clients et mes réponses, publiques et datées. Cherchez avant de demander : la réponse existe peut-être déjà.</p>
    </div>
</section>

<section class="wb-section wb-section--paper" data-tone="light">

        <div class="container" style="max-width: 860px;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="wb-h3 mb-0">Sujets récents</h2>
                <a href="{{ path('front_subjects_new') }}" class="wb-btn wb-btn--ink">Ouvrir un sujet</a>
            </div>

            {% if subjects is not empty %}
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white" data-tone="dark">
                        <h5 class="mb-0">Sujets Récents</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        {% for subject in subjects %}
                            <a href="{{ path('front_subject_show', {'subjectId': subject.id}) }}" 
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
                                <div class="me-3">
                                    <h5 class="mb-1">{{ subject.title }}</h5>
                                    <p class="mb-1 text-muted small">
                                        Posté par <strong>{{ subject.user.username }}</strong> 
                                        - le {{ subject.createdAt|format_datetime('short', 'short', locale='fr') }}
                                    </p>
                                </div>
                                <span class="badge bg-secondary rounded-pill">
                                    {{ subject.comments|length }} Réponse(s)
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="alert mt-4" role="alert">
                    <h4 class="alert-heading">Aucun sujet trouvé</h4>
                    <p>Il n'y a actuellement aucun sujet dans le centre de support. Vous pouvez être le premier à en créer un !</p>
                    <hr>
                    <a href="{{ path('front_subjects_new') }}" class="btn btn-outline-primary">Créer un Sujet</a>
                </div>
            {% endif %}
        </div>
</section>
{% endblock %}
