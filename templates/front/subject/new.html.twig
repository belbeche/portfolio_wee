{% extends 'base.html.twig' %}

{% block content %}

<section class="wb-hero" data-tone="dark">
    <div class="container" style="padding-top: 1rem; padding-bottom: 3rem;">
        <span class="wb-eyebrow">{{ app.request.locale == 'en' ? 'Forum and support' : 'Forum et support' }}</span>
        <h1 class="wb-display" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">{{ app.request.locale == 'en' ? 'Open a topic' : 'Ouvrir un sujet' }}</h1>
        <p class="wb-lead wb-lead--on-dark mb-0" style="max-width:620px;">
            Décrivez votre situation en une phrase de titre et autant de détails que
            nécessaire. Une capture d'écran vaut souvent dix lignes.
        </p>
    </div>
</section>

<section class="wb-section wb-section--paper" data-tone="light">
    <div class="container" style="max-width: 760px;">

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="wb-card" data-tone="light">
            {% include 'front/includes/_Subject_form.html.twig' %}
            {% if app.request.attributes.get('_route') == 'front_subjects_new' and subject.images is not empty %}
                {% for image in subject.images %}
                    <div>
                        <img src="{{ asset('/uploads/subject'~image.name) }}" alt="{{ subject.name }}" width="150">

                        {# We add a link to delete an image (will be managed in Ajax in images.js) #}
                        <a href="{{ path('back_subjects_remove_image', {id: image.id})}}" data-delete data-token="{{ csrf_token('delete' ~ image.id )}}">
                            <i class="bi bi-file-earmark-x"></i>
                            Supprimer
                        </a>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
